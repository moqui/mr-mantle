<eecas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-eca-3.xsd">
    <eeca id="SettlementOriginalPosting" entity="mantle.ledger.transaction.AcctgTrans" on-create="true" on-update="true" on-delete="true" run-before="true" run-on-error="false" get-entire-entity="true" get-original-value="true">
        <description>Applications retain their original posted source until they are unapplied.</description>
        <actions><script>ec.resource.script('component://mr-mantle/service/mantle/account/SourcePostingGuard.js').guardTransaction(context)</script></actions>
    </eeca>
    <eeca id="SettlementOriginalPostingEntry" entity="mantle.ledger.transaction.AcctgTransEntry" on-create="true" on-update="true" on-delete="true" run-before="true" run-on-error="false" get-entire-entity="true" get-original-value="true">
        <description>Adopted source amounts/accounts remain backed while bank reconciliation metadata can change.</description>
        <actions><script>ec.resource.script('component://mr-mantle/service/mantle/account/SourcePostingGuard.js').guardEntry(context)</script></actions>
    </eeca>
</eecas>
