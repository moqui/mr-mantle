<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <entity entity-name="ProductCatalogSetting" package="mantle.product" create-only="true">
        <description>Immutable organization catalog policy revisions; writes lock the organization and compare the expected revision.</description>
        <field name="organizationPartyId" type="id" is-pk="true"/>
        <field name="settingType" type="text-short" is-pk="true"/>
        <field name="versionSeqId" type="number-integer" is-pk="true"/>
        <field name="settingsJson" type="text-very-long"/>
        <field name="createdDate" type="date-time" default="ec.user.nowTimestamp"/>
        <field name="createdByUserId" type="id" default="ec.user.userId"/>
        <relationship type="one" related="mantle.party.Party"><key-map field-name="organizationPartyId" related="partyId"/></relationship>
    </entity>
    <entity entity-name="ProductVariantSetting" package="mantle.product">
        <description>Organization variant policy. Changes close the current dated row and create its successor.</description>
        <field name="organizationPartyId" type="id" is-pk="true"/>
        <field name="fromDate" type="date-time" is-pk="true" enable-audit-log="true"/>
        <field name="thruDate" type="date-time" enable-audit-log="true"/>
        <field name="batchLimit" type="number-integer" enable-audit-log="true"/>
        <field name="copyFields" type="text-long" enable-audit-log="true"/>
        <field name="copyCategoryMembers" type="text-indicator" enable-audit-log="true"/>
        <field name="identifierPattern" type="text-medium" enable-audit-log="true"/>
        <field name="changeReason" type="text-long" enable-audit-log="true"/>
        <relationship type="one" related="mantle.party.Party"><key-map field-name="organizationPartyId" related="partyId"/></relationship>
    </entity>
    <entity entity-name="ProductVariantIdentity" package="mantle.product">
        <description>A variant's canonical identity, not a revision. Serialized feature IDs are sorted, unique, and limited to 32.</description>
        <field name="baseProductId" type="id" is-pk="true"/>
        <field name="featureKey" type="text-long" is-pk="true"/>
        <field name="productId" type="id"/>
        <relationship type="one" title="Base" related="mantle.product.Product"><key-map field-name="baseProductId" related="productId"/></relationship>
        <relationship type="one" related="mantle.product.Product"/>
    </entity>
    <entity entity-name="ProductCatalogOperation" package="mantle.product">
        <description>A submitted catalog operation has its own identity and durable work/results; it is not a product snapshot or revision. Imports reuse this manifest in P12.</description>
        <field name="operationKey" type="id" is-pk="true"/>
        <field name="operationType" type="text-short"/>
        <field name="productId" type="id"/>
        <field name="ownerPartyId" type="id"/>
        <field name="submittedByUserId" type="id"/>
        <field name="submittedDate" type="date-time"/>
        <field name="requestJson" type="text-very-long"/>
        <relationship type="one" related="mantle.product.Product"/>
        <relationship type="one" title="Owner" related="mantle.party.Party"><key-map field-name="ownerPartyId" related="partyId"/></relationship>
    </entity>
    <entity entity-name="ProductCatalogOperationItem" package="mantle.product">
        <field name="operationKey" type="id" is-pk="true"/>
        <field name="itemSeqId" type="number-integer" is-pk="true"/>
        <field name="itemKey" type="text-long"/>
        <field name="requestJson" type="text-very-long"/>
        <field name="result" type="text-short"/>
        <field name="resultProductId" type="id"/><field name="resultRecordId" type="id"/><field name="resultEntityName" type="text-medium"/>
        <field name="errorMessage" type="text-long"/>
        <field name="completedDate" type="date-time"/>
        <relationship type="one" related="mantle.product.ProductCatalogOperation"/>
    </entity>
</entities>
