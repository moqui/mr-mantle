<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <extend-entity entity-name="PartyAcctgPreference" package="mantle.ledger.config">
        <field name="postingGuardEnabled" type="text-indicator" default="'N'" enable-audit-log="update"/>
        <field name="requiredLedgerDimensionsEnabled" type="text-indicator" default="'N'" enable-audit-log="update"/>
        <field name="forwardIssuanceRepostEnabled" type="text-indicator" default="'N'" enable-audit-log="update"/>
        <field name="allowAccountingSelfApproval" type="text-indicator" default="'N'" enable-audit-log="update"/>
        <field name="invoiceDocumentTemplate" type="text-medium" enable-audit-log="update"/>
        <field name="paymentDocumentTemplate" type="text-medium" enable-audit-log="update"/>
        <field name="documentLocale" type="text-medium" enable-audit-log="update"/>
        <field name="documentFooter" type="text-medium" enable-audit-log="update"/>
        <field name="invoiceEmailTemplateId" type="text-medium" enable-audit-log="update"/>
    </extend-entity>
    <extend-entity entity-name="GlAccountOrganization" package="mantle.ledger.account">
        <field name="fromDate" type="date-time" enable-audit-log="update"/>
        <field name="thruDate" type="date-time" enable-audit-log="update"/>
        <field name="facilityRequired" type="text-indicator" enable-audit-log="update"/>
        <field name="costCenterRequired" type="text-indicator" enable-audit-log="update"/>
    </extend-entity>
    <extend-entity entity-name="AcctgTransEntry" package="mantle.ledger.transaction">
        <field name="facilityId" type="id" enable-audit-log="update"/>
        <field name="costCenterId" type="id" enable-audit-log="update"/>
    </extend-entity>
    <extend-entity entity-name="AcctgTrans" package="mantle.ledger.transaction">
        <field name="acctgTransTemplateId" type="id" enable-audit-log="update"/>
        <field name="templateFromDate" type="date-time"/>
        <field name="templateVersion" type="number-integer"/>
        <field name="description" type="text-medium" enable-audit-log="update"/>
        <field name="postingFailureCode" type="text-short" enable-audit-log="update"/>
        <field name="postingFailureMessage" type="text-long" enable-audit-log="update"/>
        <field name="changeReason" type="text-medium" enable-audit-log="update"/>
    </extend-entity>
    <extend-entity entity-name="UomConversion" package="moqui.basic">
        <field name="fromDate" type="date-time" enable-audit-log="true"/>
        <field name="thruDate" type="date-time" enable-audit-log="true"/>
        <field name="conversionFactor" type="number-float" enable-audit-log="true"/>
        <field name="rateSource" type="text-medium" enable-audit-log="update"/>
    </extend-entity>
    <entity entity-name="AccountingLock" package="mantle.ledger.config" cache="never">
        <field name="accountingLockId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id" enable-audit-log="true"/>
        <field name="lockScope" type="text-short" enable-audit-log="true"/>
        <field name="lockThroughDate" type="date" enable-audit-log="true"/>
        <field name="isHard" type="text-indicator" enable-audit-log="true"/>
        <field name="changeReason" type="text-medium" enable-audit-log="true"/>
        <field name="changedByUserId" type="id" enable-audit-log="true"/>
    </entity>
    <entity entity-name="AccountingLockException" package="mantle.ledger.config" cache="never">
        <field name="accountingLockExceptionId" type="id" is-pk="true"/>
        <field name="accountingLockId" type="id" enable-audit-log="true"/>
        <field name="organizationPartyId" type="id" enable-audit-log="true"/>
        <field name="userId" type="id" enable-audit-log="true"/>
        <field name="userGroupId" type="id" enable-audit-log="true"/>
        <field name="acctgTransId" type="id" enable-audit-log="true"/>
        <field name="lockScope" type="text-short" enable-audit-log="true"/>
        <field name="fromDate" type="date-time" enable-audit-log="true"/>
        <field name="thruDate" type="date-time" enable-audit-log="true"/>
        <field name="changeReason" type="text-medium" enable-audit-log="true"/>
        <field name="approvedByUserId" type="id" enable-audit-log="true"/>
    </entity>
    <entity entity-name="JournalPreview" package="mantle.ledger.transaction" cache="never">
        <field name="previewId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id" enable-audit-log="true"/>
        <field name="acctgTransId" type="id" enable-audit-log="true"/>
        <field name="userId" type="id" enable-audit-log="true"/>
        <field name="inputFingerprint" type="text-long" enable-audit-log="true"/>
        <field name="expiresDate" type="date-time" enable-audit-log="true"/>
        <field name="glJournalId" type="id"/>
        <field name="requestJson" type="text-very-long"/>
        <field name="resultJson" type="text-very-long"/>
    </entity>
    <entity entity-name="AcctgTransTemplate" package="mantle.ledger.transaction" cache="never">
        <field name="acctgTransTemplateId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id" enable-audit-log="true"/>
        <field name="templateName" type="text-medium" enable-audit-log="true"/>
        <field name="acctgTransTypeEnumId" type="id" enable-audit-log="true"/>
        <field name="amountUomId" type="id" enable-audit-log="true"/>
        <field name="description" type="text-medium" enable-audit-log="true"/>
        <field name="fromDate" type="date-time" enable-audit-log="true"/>
        <field name="thruDate" type="date-time" enable-audit-log="true"/>
        <field name="isPublished" type="text-indicator" enable-audit-log="true"/>
        <field name="templateFamilyId" type="id" enable-audit-log="true"/>
        <field name="replacesTemplateId" type="id" enable-audit-log="true"/>
        <field name="templateVersion" type="number-integer" enable-audit-log="true"/>
    </entity>
    <entity entity-name="AcctgTransTemplateEntry" package="mantle.ledger.transaction" cache="never">
        <field name="acctgTransTemplateId" type="id" is-pk="true"/>
        <field name="entrySeqId" type="id" is-pk="true"/>
        <field name="glAccountId" type="id" enable-audit-log="true"/>
        <field name="debitCreditFlag" type="text-indicator" enable-audit-log="true"/>
        <field name="amount" type="currency-amount" enable-audit-log="true"/>
        <field name="amountParameter" type="text-short" enable-audit-log="true"/>
        <field name="facilityId" type="id" enable-audit-log="true"/>
        <field name="costCenterId" type="id" enable-audit-log="true"/>
        <field name="productId" type="id" enable-audit-log="true"/>
        <field name="assetId" type="id" enable-audit-log="true"/>
        <field name="description" type="text-medium" enable-audit-log="true"/>
    </entity>
    <entity entity-name="AcctgTransContent" package="mantle.ledger.transaction" cache="never">
        <field name="acctgTransContentId" type="id" is-pk="true"/>
        <field name="acctgTransId" type="id" enable-audit-log="true"/>
        <field name="contentTypeEnumId" type="id" enable-audit-log="true"/>
        <field name="contentDate" type="date-time" enable-audit-log="true"/>
        <field name="contentLocation" type="text-long" enable-audit-log="true"/>
        <field name="description" type="text-medium" enable-audit-log="true"/>
        <field name="userId" type="id" enable-audit-log="true"/>
    </entity>
    <entity entity-name="CurrencyRateImport" package="mantle.ledger.config" cache="never">
        <field name="importId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="userId" type="id"/>
        <field name="submittedDate" type="date-time"/>
        <field name="resultJson" type="text-very-long"/>
    </entity>
    <extend-entity entity-name="Uom" package="moqui.basic">
        <field name="fractionDigits" type="number-integer" enable-audit-log="update"/>
    </extend-entity>
    <extend-entity entity-name="GlAccountCategoryMember" package="mantle.ledger.account">
        <field name="fromDate" type="date-time" is-pk="true" enable-audit-log="true"/>
        <field name="thruDate" type="date-time" enable-audit-log="true"/>
    </extend-entity>
    <extend-entity entity-name="GlAccountGroupMember" package="mantle.ledger.account">
        <field name="glAccountGroupId" type="id" enable-audit-log="update"/>
    </extend-entity>
    <entity entity-name="PaymentGatewayOrganization" package="mantle.account.method" cache="never">
        <description>Organization gateway bindings provisioned outside finance forms. Finance administrators may bind methods only to these active gateways; credentials and executable configuration remain in Admin.</description>
        <field name="organizationPartyId" type="id" enable-audit-log="update" is-pk="true"/>
        <field name="paymentGatewayConfigId" type="id" enable-audit-log="update" is-pk="true"/>
        <field name="fromDate" type="date-time" enable-audit-log="update"/>
        <field name="thruDate" type="date-time" enable-audit-log="update"/>
        <field name="isEnabled" type="text-indicator" enable-audit-log="update" default="'Y'"/>
        <relationship type="one" title="Organization" related="mantle.party.Party">
            <key-map field-name="organizationPartyId" related="partyId"/>
        </relationship>
        <relationship type="one" related="mantle.account.method.PaymentGatewayConfig"/>
    </entity>
</entities>
