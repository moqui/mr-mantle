<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <entity entity-name="ProductCatalogImportKind" package="mantle.product" use="configuration">
        <description>Import adapters registered by owning domains. Every adapter must validate and store through a guarded Mantle service.</description>
        <field name="kindId" type="id" is-pk="true"/>
        <field name="description" type="text-medium"/>
        <field name="permissionId" type="id"/>
        <field name="readPermissionId" type="id"/>
        <field name="validatorService" type="text-medium"/>
        <field name="storeService" type="text-medium"/>
        <field name="batchValidatorService" type="text-medium"/>
        <field name="afterStoreService" type="text-medium"/>
        <field name="organizationField" type="text-medium"/>
        <field name="fixedParametersJson" type="text-long"/>
        <field name="columnsJson" type="text-very-long"/>
        <field name="keyFields" type="text-long"/>
        <field name="sequenceNum" type="number-integer"/>
    </entity>
</entities>
