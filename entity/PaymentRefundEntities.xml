<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <entity entity-name="PaymentRefundPreview" package="mantle.account.payment" cache="never">
        <description>An owner-bound immutable review of exact opposite cash, original funding and payment-pair reclassification.</description>
        <field name="previewId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="paymentId" type="id"/>
        <field name="refundPaymentId" type="id"/>
        <field name="userId" type="id"/>
        <field name="sourceVersion" type="text-long"/>
        <field name="refundSourceVersion" type="text-long"/>
        <field name="amount" type="currency-amount"/>
        <field name="currencyUomId" type="id"/>
        <field name="effectiveDate" type="date-time"/>
        <field name="accountingDate" type="date"/>
        <field name="inputFingerprint" type="text-long"/>
        <field name="requestJson" type="text-very-long"/>
        <field name="payloadJson" type="text-very-long"/>
        <field name="status" type="text-short"/>
        <field name="operationKey" type="id"/>
        <field name="resultJson" type="text-very-long"/>
        <field name="createdDate" type="date-time"/>
        <field name="expiresDate" type="date-time"/>
        <index name="REFUND_REVIEW_OWNER">
            <index-field name="organizationPartyId"/>
            <index-field name="userId"/>
            <index-field name="createdDate"/>
        </index>
    </entity>
    <entity entity-name="PaymentRefundRecord" package="mantle.account.payment" cache="never">
        <description>Permanent actual refund money, source and exact consumed funding identity; independent of adoption flags.</description>
        <field name="refundPaymentId" type="id" is-pk="true"/>
        <field name="originalPaymentId" type="id"/>
        <field name="organizationPartyId" type="id"/>
        <field name="partyId" type="id"/>
        <field name="financeDirection" type="text-short"/>
        <field name="cashDirection" type="text-short"/>
        <field name="amount" type="currency-amount"/>
        <field name="currencyUomId" type="id"/>
        <field name="accountingDate" type="date"/>
        <field name="effectiveDate" type="date-time"/>
        <field name="paymentApplicationId" type="id"/>
        <field name="originalAcctgTransId" type="id"/>
        <field name="cashAcctgTransId" type="id"/>
        <field name="applicationAcctgTransId" type="id"/>
        <field name="sourceControlGlAccountId" type="id"/>
        <field name="refundControlGlAccountId" type="id"/>
        <field name="cashGlAccountId" type="id"/>
        <field name="sourceVersion" type="text-long"/>
        <field name="refundSourceVersion" type="text-long"/>
        <field name="methodEvidenceHash" type="text-long"/>
        <field name="evidenceHash" type="text-long"/>
        <field name="operationKey" type="id"/>
        <field name="paymentLifecycleEventId" type="id"/>
        <field name="gatewayAttemptId" type="id"/>
        <field name="createdDate" type="date-time"/>
        <field name="userId" type="id"/>
        <field name="resultJson" type="text-very-long"/>
        <index name="REFUND_FUNDING_APPLICATION" unique="true">
            <index-field name="paymentApplicationId"/>
        </index>
        <index name="REFUND_RECORDED_OPERATION" unique="true">
            <index-field name="operationKey"/>
        </index>
        <index name="REFUND_ORIGINAL_CASH">
            <index-field name="originalPaymentId"/>
            <index-field name="createdDate"/>
        </index>
        <index name="REFUND_ORIGINAL_POSTING">
            <index-field name="originalAcctgTransId"/>
        </index>
        <index name="REFUND_CASH_POSTING">
            <index-field name="cashAcctgTransId"/>
        </index>
        <index name="REFUND_AP_POSTING">
            <index-field name="applicationAcctgTransId"/>
        </index>
    </entity>
    <entity entity-name="PaymentRefundDraftClaim" package="mantle.account.payment" cache="never">
        <description>A held optional provider refund draft is unavailable to other writers; definitive decline releases it and consumed claims never recycle.</description>
        <field name="refundPaymentId" type="id" is-pk="true"/>
        <field name="originalPaymentId" type="id"/>
        <field name="organizationPartyId" type="id"/>
        <field name="attemptId" type="id"/>
        <field name="status" type="text-short"/>
        <field name="createdDate" type="date-time"/>
        <field name="releasedDate" type="date-time"/>
        <field name="consumedDate" type="date-time"/>
        <index name="REFUND_DRAFT_CLAIM_ATTEMPT">
            <index-field name="attemptId"/>
        </index>
    </entity>
    <view-entity entity-name="RefundDraftAppliedSource" package="mantle.account.payment" cache="never">
        <member-entity entity-alias="A" entity-name="mantle.account.payment.PaymentApplication"/>
        <alias entity-alias="A" name="paymentId"/>
        <alias entity-alias="A" name="rowCount" field="paymentApplicationId" function="count"/>
    </view-entity>
    <view-entity entity-name="RefundDraftAppliedTarget" package="mantle.account.payment" cache="never">
        <member-entity entity-alias="A" entity-name="mantle.account.payment.PaymentApplication"/>
        <alias entity-alias="A" name="toPaymentId"/>
        <alias entity-alias="A" name="rowCount" field="paymentApplicationId" function="count"/>
    </view-entity>
    <view-entity entity-name="RefundDraftPostingHistory" package="mantle.account.payment" cache="never">
        <member-entity entity-alias="T" entity-name="mantle.ledger.transaction.AcctgTrans"/>
        <alias entity-alias="T" name="paymentId"/>
        <alias entity-alias="T" name="rowCount" field="acctgTransId" function="count"/>
    </view-entity>
    <view-entity entity-name="RefundDraftProviderHistory" package="mantle.account.payment" cache="never">
        <member-entity entity-alias="R" entity-name="mantle.account.method.PaymentGatewayResponse"/>
        <alias entity-alias="R" name="paymentId"/>
        <alias entity-alias="R" name="rowCount" field="paymentGatewayResponseId" function="count"/>
    </view-entity>
    <view-entity entity-name="RefundDraftTargetPostingHistory" package="mantle.account.payment" cache="never">
        <member-entity entity-alias="T" entity-name="mantle.ledger.transaction.AcctgTrans"/>
        <alias entity-alias="T" name="toPaymentId"/>
        <alias entity-alias="T" name="rowCount" field="acctgTransId" function="count"/>
    </view-entity>
    <view-entity entity-name="PaymentRefundDraftRead" package="mantle.account.payment" cache="never">
        <member-entity entity-alias="P" entity-name="mantle.account.payment.PaymentLifecycleBalance"/>
        <member-entity entity-alias="S" entity-name="mantle.account.payment.RefundDraftAppliedSource" join-from-alias="P" join-optional="true" sub-select="true">
            <key-map field-name="paymentId"/>
        </member-entity>
        <member-entity entity-alias="T" entity-name="mantle.account.payment.RefundDraftAppliedTarget" join-from-alias="P" join-optional="true" sub-select="true">
            <key-map field-name="paymentId" related="toPaymentId"/>
        </member-entity>
        <member-entity entity-alias="G" entity-name="mantle.account.payment.RefundDraftPostingHistory" join-from-alias="P" join-optional="true" sub-select="true">
            <key-map field-name="paymentId"/>
        </member-entity>
        <member-entity entity-alias="R" entity-name="mantle.account.payment.RefundDraftProviderHistory" join-from-alias="P" join-optional="true" sub-select="true">
            <key-map field-name="paymentId"/>
        </member-entity>
        <member-entity entity-alias="U" entity-name="mantle.account.payment.RefundDraftTargetPostingHistory" join-from-alias="P" join-optional="true" sub-select="true">
            <key-map field-name="paymentId" related="toPaymentId"/>
        </member-entity>
        <member-entity entity-alias="C" entity-name="mantle.account.payment.PaymentRefundDraftClaim" join-from-alias="P" join-optional="true">
            <key-map field-name="paymentId" related="refundPaymentId"/>
        </member-entity>
        <member-entity entity-alias="L" entity-name="mantle.account.payment.PaymentLegacyGatewayFence" join-from-alias="P" join-optional="true">
            <key-map field-name="paymentId"/>
        </member-entity>
        <member-entity entity-alias="M" entity-name="mantle.account.method.PaymentMethod" join-from-alias="P" join-optional="true">
            <key-map field-name="paymentMethodId"/>
        </member-entity>
        <member-entity entity-alias="N" entity-name="mantle.account.method.PaymentMethod" join-from-alias="P" join-optional="true">
            <key-map field-name="toPaymentMethodId" related="paymentMethodId"/>
        </member-entity>
        <alias-all entity-alias="P"/>
        <alias name="sourceApplicationCount" type="number-integer">
            <complex-alias operator="+">
                <complex-alias-field entity-alias="S" field="rowCount" default-value="0"/>
            </complex-alias>
        </alias>
        <alias name="targetApplicationCount" type="number-integer">
            <complex-alias operator="+">
                <complex-alias-field entity-alias="T" field="rowCount" default-value="0"/>
            </complex-alias>
        </alias>
        <alias name="postingCount" type="number-integer">
            <complex-alias operator="+">
                <complex-alias-field entity-alias="G" field="rowCount" default-value="0"/>
            </complex-alias>
        </alias>
        <alias name="targetPostingCount" type="number-integer">
            <complex-alias operator="+">
                <complex-alias-field entity-alias="U" field="rowCount" default-value="0"/>
            </complex-alias>
        </alias>
        <alias name="providerCount" type="number-integer">
            <complex-alias operator="+">
                <complex-alias-field entity-alias="R" field="rowCount" default-value="0"/>
            </complex-alias>
        </alias>
        <alias entity-alias="C" name="draftClaimStatus" field="status"/>
        <alias entity-alias="L" name="everEnteredProvider"/>
        <alias entity-alias="M" name="sourceGatewayConfigId" field="paymentGatewayConfigId"/>
        <alias entity-alias="N" name="targetGatewayConfigId" field="paymentGatewayConfigId"/>
        <alias entity-alias="M" name="sourceMethodTypeEnumId" field="paymentMethodTypeEnumId"/>
        <alias entity-alias="N" name="targetMethodTypeEnumId" field="paymentMethodTypeEnumId"/>
    </view-entity>
</entities>
