<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <entity entity-name="PaymentGatewayTestControl" package="mantle.account.payment" cache="never">
        <description>Deterministic reviewed-provider fixture controls; never used by production gateway integrations.</description>
        <field name="paymentGatewayConfigId" type="id" is-pk="true"/>
        <field name="outcomesJson" type="text-very-long"/>
        <field name="lookupOutcomesJson" type="text-very-long"/>
        <field name="holdAfterAccept" type="text-indicator"/>
        <field name="releaseProvider" type="text-indicator"/>
        <field name="holdLookup" type="text-indicator"/>
        <field name="releaseLookup" type="text-indicator"/>
        <field name="holdBeforeEffect" type="text-indicator"/>
        <field name="releaseEffect" type="text-indicator"/>
        <field name="enteredEffect" type="text-indicator"/>
        <field name="holdBeforePrepare" type="text-indicator"/>
        <field name="releasePrepare" type="text-indicator"/>
        <field name="enteredPrepare" type="text-indicator"/>
        <field name="barrierPaymentId" type="id"/>
        <field name="barrierAction" type="text-short"/>
        <field name="lookupNoExecution" type="text-indicator"/>
        <field name="replyAmount" type="currency-amount"/>
        <field name="replyCurrencyUomId" type="id"/>
        <field name="replyOperationId" type="id"/>
        <field name="probeMutation" type="text-short"/>
    </entity>
    <entity entity-name="PaymentGatewayTestEffect" package="mantle.account.payment" cache="never">
        <description>An independently committed provider-side outcome keyed by exact request identity, including accepted-before-timeout effects.</description>
        <field name="providerOperationId" type="id" is-pk="true"/>
        <field name="merchantNamespace" type="text-medium" is-pk="true"/>
        <field name="paymentGatewayConfigId" type="id"/>
        <field name="adapterVersion" type="text-short"/>
        <field name="paymentId" type="id"/>
        <field name="action" type="text-short"/>
        <field name="amount" type="currency-amount"/>
        <field name="currencyUomId" type="id"/>
        <field name="requestHash" type="text-long"/>
        <field name="outcome" type="text-short"/>
        <field name="providerReference" type="text-medium"/>
        <field name="providerDate" type="date-time"/>
        <field name="invocationCount" type="number-integer"/>
        <field name="lookupCount" type="number-integer"/>
        <field name="probeError" type="text-medium"/>
        <field name="sourceMethodVersion" type="text-long"/>
        <field name="destinationMethodVersion" type="text-long"/>
        <field name="sourceCredentialHash" type="text-long"/>
        <field name="destinationCredentialHash" type="text-long"/>
        <index name="GATEWAY_TEST_EFFECT_PAYMENT">
            <index-field name="paymentId"/>
            <index-field name="action"/>
        </index>
    </entity>
    <entity entity-name="PaymentGatewayTestObservation" package="mantle.account.payment" cache="never">
        <description>Independent observations and caller-local rollback markers for gateway transaction-boundary regression proofs.</description>
        <field name="observationId" type="id" is-pk="true"/>
        <field name="resultJson" type="text-very-long"/>
    </entity>
</entities>
