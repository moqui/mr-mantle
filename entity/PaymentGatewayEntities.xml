<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <extend-entity entity-name="PaymentGatewayResponse" package="mantle.account.method">
        <field name="operationKey" type="id"><description>The key of the authorize#, capture#, release# or
            refund#SinglePayment call that got this response; a retry with the key answers this response.</description></field>
        <field name="refundPaymentId" type="id"><description>The refund Payment a refund response created or
            completed.</description></field>
        <relationship type="one" title="Refund" related="mantle.account.payment.Payment" short-alias="refundPayment">
            <key-map field-name="refundPaymentId" related="paymentId"/>
        </relationship>
        <index name="PMT_GTWR_OPERATION">
            <index-field name="paymentId"/>
            <index-field name="operationKey"/>
        </index>
        <index name="PMT_GTWR_REFUND">
            <index-field name="refundPaymentId"/>
        </index>
    </extend-entity>
    <view-entity entity-name="PaymentGatewayResponseFinance" package="mantle.account.method" cache="never">
        <description>Gateway responses with the parties of their payment, for organization and privacy conditions.</description>
        <member-entity entity-alias="R" entity-name="mantle.account.method.PaymentGatewayResponse"/>
        <member-entity entity-alias="P" entity-name="mantle.account.payment.PaymentFinance" join-from-alias="R">
            <key-map field-name="paymentId"/>
        </member-entity>
        <alias-all entity-alias="R"/>
        <alias entity-alias="P" name="fromPartyId"/>
        <alias entity-alias="P" name="toPartyId"/>
        <alias entity-alias="P" name="paymentStatusId" field="statusId"/>
        <alias entity-alias="P" name="fromPrivateOwnerUserId"/>
        <alias entity-alias="P" name="toPrivateOwnerUserId"/>
    </view-entity>
</entities>
