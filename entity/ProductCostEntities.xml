<?xml version="1.0" ?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <entity entity-name="ProductStandardCost" package="mantle.product.cost" cache="never">
        <description>An estimate is a dated business record. Approval starts this row, ends its predecessor and freezes its components and PDF. It never posts stock or ledger changes; there is no version sequence.</description>
        <field name="productStandardCostId" type="id" is-pk="true"/>
        <field name="productId" type="id" enable-audit-log="true"/>
        <field name="organizationPartyId" type="id" enable-audit-log="true"/>
        <field name="facilityId" type="id" enable-audit-log="true"/>
        <field name="state" type="text-short" enable-audit-log="true"/>
        <field name="fromDate" type="date-time" enable-audit-log="true"/>
        <field name="thruDate" type="date-time" enable-audit-log="true"/>
        <field name="quantity" type="number-decimal" enable-audit-log="true"/>
        <field name="quantityUomId" type="id" enable-audit-log="true"/>
        <field name="priceUomId" type="id" enable-audit-log="true"/>
        <field name="totalCost" type="currency-precise" enable-audit-log="true"/>
        <field name="unitCost" type="currency-precise" enable-audit-log="true"/>
        <field name="materialCost" type="currency-precise" enable-audit-log="true"/>
        <field name="laborCost" type="currency-precise" enable-audit-log="true"/>
        <field name="machineCost" type="currency-precise" enable-audit-log="true"/>
        <field name="overheadCost" type="currency-precise" enable-audit-log="true"/>
        <field name="outsideCost" type="currency-precise" enable-audit-log="true"/>
        <field name="productBomId" type="id" enable-audit-log="true"/>
        <field name="methodAsOfDate" type="date-time" enable-audit-log="true"/>
        <field name="materialBasis" type="text-short" enable-audit-log="true"/>
        <field name="overheadBasis" type="text-short" enable-audit-log="true"/>
        <field name="overheadPercent" type="number-decimal" enable-audit-log="true"/>
        <field name="complete" type="text-indicator" enable-audit-log="true"/>
        <field name="findingsJson" type="text-very-long" enable-audit-log="true"/>
        <field name="calculationId" type="id" enable-audit-log="true"/>
        <field name="inputFingerprint" type="text-long" enable-audit-log="true"/>
        <field name="draftedByUserId" type="id" enable-audit-log="true"/>
        <field name="lastEditedByUserId" type="id" enable-audit-log="true"/>
        <field name="approvedByUserId" type="id" enable-audit-log="true"/>
        <field name="approvedDate" type="date-time" enable-audit-log="true"/>
        <field name="approvedPdfLocation" type="text-long" enable-audit-log="true"/>
        <field name="changeReason" type="text-medium" enable-audit-log="true"/>
        <relationship type="one" related="mantle.product.Product">
            <key-map field-name="productId" related="productId"/>
        </relationship>
        <relationship type="one" related="mantle.party.Party">
            <key-map field-name="organizationPartyId" related="partyId"/>
        </relationship>
        <relationship type="one" related="mantle.facility.Facility">
            <key-map field-name="facilityId" related="facilityId"/>
        </relationship>
        <relationship type="one" related="mantle.product.bom.ProductBom">
            <key-map field-name="productBomId" related="productBomId"/>
        </relationship>
        <relationship type="one" related="moqui.basic.Uom" title="Quantity">
            <key-map field-name="quantityUomId" related="uomId"/>
        </relationship>
        <relationship type="one" related="moqui.basic.Uom" title="Currency">
            <key-map field-name="priceUomId" related="uomId"/>
        </relationship>
    </entity>
    <entity entity-name="ProductStandardCostComponent" package="mantle.product.cost" cache="never">
        <description>The quantities, rates, amounts and provenance of an estimate. Draft components are audited; the approved parent makes them immutable.</description>
        <field name="productStandardCostComponentId" type="id" is-pk="true"/>
        <field name="productStandardCostId" type="id" enable-audit-log="true"/>
        <field name="sequenceNum" type="number-integer" enable-audit-log="true"/>
        <field name="componentTypeEnumId" type="id" enable-audit-log="true"/>
        <field name="description" type="text-medium" enable-audit-log="true"/>
        <field name="path" type="text-long" enable-audit-log="true"/>
        <field name="productId" type="id" enable-audit-log="true"/>
        <field name="quantity" type="number-decimal" enable-audit-log="true"/>
        <field name="quantityUomId" type="id" enable-audit-log="true"/>
        <field name="rateAmount" type="currency-precise" enable-audit-log="true"/>
        <field name="amount" type="currency-precise" enable-audit-log="true"/>
        <field name="priceUomId" type="id" enable-audit-log="true"/>
        <field name="sourceEntityName" type="text-medium" enable-audit-log="true"/>
        <field name="sourceId" type="text-long" enable-audit-log="true"/>
        <field name="sourceFromDate" type="date-time" enable-audit-log="true"/>
        <field name="sourceFingerprint" type="text-long" enable-audit-log="true"/>
        <field name="costAllocationFactor" type="number-decimal" enable-audit-log="true"/>
        <field name="sourceRequiredCapability" type="text-short" enable-audit-log="true"/>
        <field name="createdByUserId" type="id" enable-audit-log="true"/>
        <field name="lastEditedByUserId" type="id" enable-audit-log="true"/>
        <field name="changeReason" type="text-medium" enable-audit-log="true"/>
        <relationship type="one" related="mantle.product.cost.ProductStandardCost">
            <key-map field-name="productStandardCostId" related="productStandardCostId"/>
        </relationship>
    </entity>
    <entity entity-name="ProductCostCalculation" package="mantle.product.cost" cache="never">
        <description>A short-lived reviewed calculation request and fingerprint. Save recalculates the same request, refuses changed inputs and reuses the same saved draft on retry. It is not a policy version or a second calculator.</description>
        <field name="calculationId" type="id" is-pk="true"/>
        <field name="productId" type="id" enable-audit-log="true"/>
        <field name="organizationPartyId" type="id" enable-audit-log="true"/>
        <field name="userId" type="id" enable-audit-log="true"/>
        <field name="createdDate" type="date-time" enable-audit-log="true"/>
        <field name="expiresDate" type="date-time" enable-audit-log="true"/>
        <field name="requestJson" type="text-very-long" enable-audit-log="true"/>
        <field name="inputFingerprint" type="text-long" enable-audit-log="true"/>
        <field name="complete" type="text-indicator" enable-audit-log="true"/>
        <field name="savedProductStandardCostId" type="id" enable-audit-log="true"/>
        <relationship type="one" related="mantle.product.Product">
            <key-map field-name="productId" related="productId"/>
        </relationship>
        <relationship type="one" related="mantle.party.Party">
            <key-map field-name="organizationPartyId" related="partyId"/>
        </relationship>
    </entity>
</entities>
