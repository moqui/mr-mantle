<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <entity entity-name="ProductPriceList" package="mantle.product">
        <field name="priceListId" type="id" is-pk="true"/>
        <field name="listName" type="text-medium" enable-audit-log="true"/>
        <field name="organizationPartyId" type="id" enable-audit-log="true"/>
        <field name="direction" type="text-short" enable-audit-log="true"/>
        <field name="pricePurposeEnumId" type="id" enable-audit-log="true"/>
        <field name="priceUomId" type="id" enable-audit-log="true"/>
        <field name="productStoreId" type="id" enable-audit-log="true"/>
        <field name="agreementId" type="id" enable-audit-log="true"/>
        <field name="agreementItemSeqId" type="id" enable-audit-log="true"/>
        <field name="partyClassificationId" type="id" enable-audit-log="true"/>
        <field name="geoId" type="id" enable-audit-log="true"/>
        <field name="priority" type="number-integer" enable-audit-log="true"/>
        <field name="state" type="text-short" enable-audit-log="true"/>
        <field name="fromDate" type="date-time" enable-audit-log="true"/>
        <field name="thruDate" type="date-time" enable-audit-log="true"/>
        <field name="changeReason" type="text-long" enable-audit-log="true"/>
        <relationship type="one" title="Organization" related="mantle.party.Party"><key-map field-name="organizationPartyId" related="partyId"/></relationship>
    </entity>
    <entity entity-name="ProductPriceListParty" package="mantle.product">
        <field name="priceListId" type="id" is-pk="true"/>
        <field name="partyId" type="id" is-pk="true" enable-audit-log="true"/>
        <field name="roleTypeId" type="id" is-pk="true" enable-audit-log="true"/>
        <field name="fromDate" type="date-time" is-pk="true" enable-audit-log="true"/>
        <field name="thruDate" type="date-time" enable-audit-log="true"/>
        <field name="changeReason" type="text-long" enable-audit-log="true"/>
        <relationship type="one" related="mantle.product.ProductPriceList"/>
        <relationship type="one" related="mantle.party.Party"/>
        <relationship type="one" related="mantle.party.RoleType"/>
    </entity>
    <entity entity-name="ProductPriceRule" package="mantle.product">
        <field name="priceRuleId" type="id" is-pk="true"/>
        <field name="priceListId" type="id" enable-audit-log="true"/>
        <field name="sequenceNum" type="number-integer" enable-audit-log="true"/>
        <field name="selector" type="text-short" enable-audit-log="true"/>
        <field name="productId" type="id" enable-audit-log="true"/>
        <field name="productCategoryId" type="id" enable-audit-log="true"/>
        <field name="productFeatureId" type="id" enable-audit-log="true"/>
        <field name="partyClassificationId" type="id" enable-audit-log="true"/>
        <field name="geoId" type="id" enable-audit-log="true"/>
        <field name="minQuantity" type="number-decimal" enable-audit-log="true"/>
        <field name="maxQuantity" type="number-decimal" enable-audit-log="true"/>
        <field name="quantityUomId" type="id" enable-audit-log="true"/>
        <field name="fromDate" type="date-time" enable-audit-log="true"/>
        <field name="thruDate" type="date-time" enable-audit-log="true"/>
        <field name="baseType" type="text-short" enable-audit-log="true"/>
        <field name="basePriceTypeEnumId" type="id" enable-audit-log="true"/>
        <field name="basePriceListId" type="id" enable-audit-log="true"/>
        <field name="fixedPrice" type="currency-precise" enable-audit-log="true"/>
        <field name="percentChange" type="number-decimal" enable-audit-log="true"/>
        <field name="amountChange" type="currency-precise" enable-audit-log="true"/>
        <field name="roundingIncrement" type="number-decimal" enable-audit-log="true"/>
        <field name="minimumPrice" type="currency-precise" enable-audit-log="true"/>
        <field name="maximumPrice" type="currency-precise" enable-audit-log="true"/>
        <field name="changeReason" type="text-long" enable-audit-log="true"/>
        <relationship type="one" related="mantle.product.ProductPriceList"/>
    </entity>
    <entity entity-name="ProductPricingSetting" package="mantle.product">
        <field name="organizationPartyId" type="id" is-pk="true"/>
        <field name="fromDate" type="date-time" is-pk="true" enable-audit-log="true"/>
        <field name="thruDate" type="date-time" enable-audit-log="true"/>
        <field name="defaultPriceListId" type="id" enable-audit-log="true"/>
        <field name="defaultCurrencyUomId" type="id" enable-audit-log="true"/>
        <field name="defaultPurposeEnumId" type="id" enable-audit-log="true"/>
        <field name="roundingIncrement" type="number-decimal" enable-audit-log="true"/>
        <field name="allowedPurposeIds" type="text-long" enable-audit-log="true"/>
        <field name="changeReason" type="text-long" enable-audit-log="true"/>
        <relationship type="one" title="Organization" related="mantle.party.Party"><key-map field-name="organizationPartyId" related="partyId"/></relationship>
    </entity>
</entities>
