<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <extend-entity entity-name="ProductAssoc" package="mantle.product"><field name="quantityUomId" type="id" enable-audit-log="true"/></extend-entity>
    <entity entity-name="ProductIdentifierPolicy" package="mantle.product" cache="never">
        <field name="productIdentifierPolicyId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id" enable-audit-log="true"/>
        <field name="productIdTypeEnumId" type="id" enable-audit-log="true"/>
        <field name="fromDate" type="date-time" enable-audit-log="true"/>
        <field name="thruDate" type="date-time" enable-audit-log="true"/>
        <field name="enabled" type="text-indicator" enable-audit-log="true"/>
        <field name="format" type="text-short" enable-audit-log="true"/>
        <field name="uniquenessScope" type="text-short" enable-audit-log="true"/>
        <field name="generationRule" type="text-short" enable-audit-log="true"/>
        <field name="prefix" type="text-short" enable-audit-log="true"/>
        <field name="changeReason" type="text-medium" enable-audit-log="true"/>
        <relationship type="one" related="mantle.party.Party"><key-map field-name="organizationPartyId" related="partyId"/></relationship>
    </entity>
</entities>
