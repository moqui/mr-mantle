<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <extend-entity entity-name="Payment" package="mantle.account.payment">
        <field name="gatewayInstructionId" type="id"/>
        <field name="gatewayAttemptId" type="id"/>
        <field name="gatewayRole" type="text-short"/>
    </extend-entity>
    <extend-entity entity-name="PaymentGatewayResponse" package="mantle.account.method">
        <field name="gatewayAttemptId" type="id"/>
        <index name="PAYMENT_GATEWAY_ATTEMPT_RESPONSE" unique="true">
            <index-field name="gatewayAttemptId"/>
        </index>
    </extend-entity>
    <entity entity-name="PaymentGatewayPreview" package="mantle.account.payment" cache="never">
        <field name="previewId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="paymentId" type="id"/>
        <field name="userId" type="id"/>
        <field name="previewKind" type="text-short"/>
        <field name="action" type="text-short"/>
        <field name="instructionId" type="id"/>
        <field name="attemptId" type="id"/>
        <field name="sourceVersion" type="text-long"/>
        <field name="attemptVersion" type="text-long"/>
        <field name="inputFingerprint" type="text-long"/>
        <field name="requestJson" type="text-very-long"/>
        <field name="payloadJson" type="text-very-long"/>
        <field name="createdDate" type="date-time"/>
        <field name="expiresDate" type="date-time"/>
        <field name="status" type="text-short"/>
        <field name="operationKey" type="id"/>
        <field name="resultJson" type="text-very-long"/>
        <index name="GATEWAY_PREVIEW_PAYMENT">
            <index-field name="paymentId"/>
            <index-field name="createdDate"/>
        </index>
    </entity>
    <entity entity-name="PaymentGatewayInstruction" package="mantle.account.payment" cache="never">
        <field name="instructionId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="paymentId" type="id"/>
        <field name="partyId" type="id"/>
        <field name="currencyUomId" type="id"/>
        <field name="authorizedAmount" type="currency-amount"/>
        <field name="accountingDate" type="date"/>
        <field name="paymentGatewayConfigId" type="id"/>
        <field name="bindingVersion" type="text-long"/>
        <field name="adapterVersion" type="text-short"/>
        <field name="merchantNamespace" type="text-medium"/>
        <field name="state" type="text-short"/>
        <field name="authorizationAttemptId" type="id"/>
        <field name="createdDate" type="date-time"/>
        <field name="userId" type="id"/>
        <index name="GATEWAY_INSTRUCTION_PAYMENT" unique="true">
            <index-field name="paymentId"/>
        </index>
    </entity>
    <entity entity-name="PaymentGatewayAttempt" package="mantle.account.payment" cache="never">
        <field name="attemptId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="paymentId" type="id"/>
        <field name="partyId" type="id"/>
        <field name="instructionId" type="id"/>
        <field name="parentAttemptId" type="id"/>
        <field name="previewId" type="id"/>
        <field name="paymentGatewayResponseId" type="id"/>
        <field name="userId" type="id"/>
        <field name="operationKey" type="id"/>
        <field name="requestHash" type="text-long"/>
        <field name="action" type="text-short"/>
        <field name="amount" type="currency-amount"/>
        <field name="currencyUomId" type="id"/>
        <field name="effectiveDate" type="date-time"/>
        <field name="accountingDate" type="date"/>
        <field name="sourceVersion" type="text-long"/>
        <field name="financialSourceHash" type="text-long"/>
        <field name="paymentGatewayConfigId" type="id"/>
        <field name="bindingVersion" type="text-long"/>
        <field name="adapterVersion" type="text-short"/>
        <field name="merchantNamespace" type="text-medium"/>
        <field name="operationServiceName" type="text-medium"/>
        <field name="lookupServiceName" type="text-medium"/>
        <field name="guaranteesJson" type="text-very-long"/>
        <field name="providerOperationId" type="id"/>
        <field name="parentProviderReference" type="text-medium"/>
        <field name="providerReference" type="text-medium"/>
        <field name="providerState" type="text-short"/>
        <field name="financialState" type="text-short"/>
        <field name="responseCode" type="text-short"/>
        <field name="reasonCode" type="text-short"/>
        <field name="errorMessage" type="text-medium"/>
        <field name="providerDate" type="date-time"/>
        <field name="providerSettlementDate" type="date-time"/>
        <field name="receiptJson" type="text-very-long"/>
        <field name="frozenEvidenceJson" type="text-very-long"/>
        <field name="dispatchToken" type="text-long"/>
        <field name="leaseExpiresDate" type="date-time"/>
        <field name="lookupToken" type="text-long"/>
        <field name="lookupLeaseExpiresDate" type="date-time"/>
        <field name="dispatchCount" type="number-integer"/>
        <field name="lookupCount" type="number-integer"/>
        <field name="cashPaymentId" type="id"/>
        <field name="createdDate" type="date-time"/>
        <field name="dispatchedDate" type="date-time"/>
        <field name="completedDate" type="date-time"/>
        <field name="resultJson" type="text-very-long"/>
        <index name="GATEWAY_ATTEMPT_OPERATION" unique="true">
            <index-field name="organizationPartyId"/>
            <index-field name="operationKey"/>
        </index>
        <index name="GATEWAY_PROVIDER_OPERATION" unique="true">
            <index-field name="merchantNamespace"/>
            <index-field name="providerOperationId"/>
        </index>
        <index name="GATEWAY_ATTEMPT_CASH" unique="true">
            <index-field name="cashPaymentId"/>
        </index>
        <index name="GATEWAY_ATTEMPT_INSTRUCTION">
            <index-field name="instructionId"/>
            <index-field name="createdDate"/>
        </index>
    </entity>
    <entity entity-name="PaymentGatewayReservation" package="mantle.account.payment" cache="never">
        <field name="reservationId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="attemptId" type="id"/>
        <field name="instructionId" type="id"/>
        <field name="paymentId" type="id"/>
        <field name="sourceKind" type="text-short"/>
        <field name="sourceId" type="id"/>
        <field name="holdKind" type="text-short"/>
        <field name="amount" type="currency-amount"/>
        <field name="currencyUomId" type="id"/>
        <field name="accountingDate" type="date"/>
        <field name="status" type="text-short"/>
        <field name="createdDate" type="date-time"/>
        <field name="consumedDate" type="date-time"/>
        <index name="GATEWAY_RESERVATION_ATTEMPT" unique="true">
            <index-field name="attemptId"/>
            <index-field name="holdKind"/>
        </index>
        <index name="GATEWAY_RESERVATION_PAYMENT">
            <index-field name="paymentId"/>
            <index-field name="holdKind"/>
            <index-field name="status"/>
        </index>
    </entity>
    <view-entity entity-name="PaymentGatewayCashHold" package="mantle.account.payment" cache="never">
        <member-entity entity-alias="R" entity-name="mantle.account.payment.PaymentGatewayReservation"/>
        <alias entity-alias="R" name="organizationPartyId"/>
        <alias entity-alias="R" name="paymentId"/>
        <alias entity-alias="R" name="currencyUomId"/>
        <alias entity-alias="R" name="heldAmount" field="amount" function="sum"/>
        <alias entity-alias="R" name="holdCount" field="reservationId" function="count"/>
        <entity-condition>
            <econditions>
                <econdition entity-alias="R" field-name="holdKind" value="cash"/>
                <econdition entity-alias="R" field-name="status" value="held"/>
            </econditions>
        </entity-condition>
    </view-entity>
    <view-entity entity-name="PaymentGatewayInstructionHolds" package="mantle.account.payment" cache="never">
        <member-entity entity-alias="R" entity-name="mantle.account.payment.PaymentGatewayReservation"/>
        <alias entity-alias="R" name="instructionId"/>
        <alias entity-alias="R" name="holdKind"/>
        <alias entity-alias="R" name="status"/>
        <alias entity-alias="R" name="totalAmount" field="amount" function="sum"/>
        <alias entity-alias="R" name="holdCount" field="reservationId" function="count"/>
    </view-entity>
    <view-entity entity-name="PaymentGatewayInstructionTotals" package="mantle.account.payment" cache="never">
        <member-entity entity-alias="A" entity-name="mantle.account.payment.PaymentGatewayAttempt"/>
        <alias entity-alias="A" name="instructionId"/>
        <alias entity-alias="A" name="action"/>
        <alias entity-alias="A" name="providerState"/>
        <alias entity-alias="A" name="financialState"/>
        <alias entity-alias="A" name="totalAmount" field="amount" function="sum"/>
        <alias entity-alias="A" name="attemptCount" field="attemptId" function="count"/>
    </view-entity>
    <view-entity entity-name="PaymentGatewayBindingRead" package="mantle.account.method" cache="never">
        <member-entity entity-alias="B" entity-name="mantle.account.method.PaymentGatewayOrganization"/>
        <member-entity entity-alias="C" entity-name="mantle.account.method.PaymentGatewayConfig" join-from-alias="B">
            <key-map field-name="paymentGatewayConfigId"/>
        </member-entity>
        <alias-all entity-alias="B"/>
        <alias entity-alias="C" name="description"/>
        <alias entity-alias="C" name="reviewedOperationServiceName"/>
        <alias entity-alias="C" name="reviewedLookupServiceName"/>
        <alias entity-alias="C" name="reviewedAdapterVersion"/>
        <alias entity-alias="C" name="reviewedMerchantNamespace"/>
        <alias entity-alias="C" name="reviewedGuaranteesJson"/>
    </view-entity>
    <view-entity entity-name="PaymentGatewayAvailableBalance" package="mantle.account.payment" cache="never">
        <member-entity entity-alias="P" entity-name="mantle.account.payment.SettlementPaymentBalance"/>
        <member-entity entity-alias="H" entity-name="mantle.account.payment.PaymentGatewayCashHold" join-from-alias="P" join-optional="true">
            <key-map field-name="paymentId"/>
        </member-entity>
        <alias-all entity-alias="P"/>
        <alias name="reservedAmount">
            <complex-alias operator="+">
                <complex-alias-field entity-alias="H" field="heldAmount" default-value="0"/>
            </complex-alias>
        </alias>
        <alias name="availableAmount">
            <complex-alias operator="-">
                <complex-alias-field entity-alias="P" field="balanceRemaining"/>
                <complex-alias-field entity-alias="H" field="heldAmount" default-value="0"/>
            </complex-alias>
        </alias>
    </view-entity>
    <view-entity entity-name="PaymentGatewayLifecycleBalance" package="mantle.account.payment" cache="never">
        <member-entity entity-alias="P" entity-name="mantle.account.payment.PaymentLifecycleBalance"/>
        <member-entity entity-alias="H" entity-name="mantle.account.payment.PaymentGatewayCashHold" join-from-alias="P" join-optional="true">
            <key-map field-name="paymentId"/>
        </member-entity>
        <alias-all entity-alias="P"/>
        <alias name="reservedAmount">
            <complex-alias operator="+">
                <complex-alias-field entity-alias="H" field="heldAmount" default-value="0"/>
            </complex-alias>
        </alias>
        <alias name="availableAmount">
            <complex-alias operator="-">
                <complex-alias-field entity-alias="P" field="balanceRemaining"/>
                <complex-alias-field entity-alias="H" field="heldAmount" default-value="0"/>
            </complex-alias>
        </alias>
    </view-entity>
    <view-entity entity-name="PaymentGatewayTransactionRead" package="mantle.account.payment" cache="never">
        <member-entity entity-alias="R" entity-name="mantle.account.method.PaymentGatewayResponse"/>
        <member-entity entity-alias="A" entity-name="mantle.account.payment.PaymentGatewayAttempt" join-from-alias="R" join-optional="true">
            <key-map field-name="gatewayAttemptId" related="attemptId"/>
        </member-entity>
        <member-entity entity-alias="P" entity-name="mantle.account.payment.PaymentFinance" join-from-alias="R">
            <key-map field-name="paymentId"/>
        </member-entity>
        <alias-all entity-alias="R"/>
        <alias entity-alias="A" name="attemptId"/>
        <alias entity-alias="A" name="organizationPartyId"/>
        <alias entity-alias="A" name="action"/>
        <alias entity-alias="A" name="providerState"/>
        <alias entity-alias="A" name="financialState"/>
        <alias entity-alias="A" name="cashPaymentId"/>
        <alias entity-alias="A" name="accountingDate"/>
        <alias entity-alias="A" name="createdDate"/>
        <alias entity-alias="P" name="fromPartyId"/>
        <alias entity-alias="P" name="toPartyId"/>
        <alias entity-alias="P" name="fromPrivateOwnerUserId"/>
        <alias entity-alias="P" name="toPrivateOwnerUserId"/>
    </view-entity>
</entities>
