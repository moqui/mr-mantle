<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
  <entity entity-name="PublicSite" package="mantle.public">
    <field name="siteId" type="id" is-pk="true"/>
    <field name="name" type="text-medium"/>
    <field name="state" type="id"/>
    <field name="locale" type="id"/>
    <field name="timeZone" type="id"/>
    <field name="theme" type="text-long"/>
    <field name="policyRevision" type="number-integer"/>
    <field name="registrationMode" type="id"/>
    <field name="approvalRequired" type="text-indicator"/>
    <field name="generation" type="number-integer"/>
    <field name="subscriptionUrl" type="text-medium"><description>Registered page where members manage a paid subscription; Forum links to it and implements no checkout.</description></field>
  </entity>
  <entity entity-name="PublicSiteHost" package="mantle.public">
    <field name="hostname" type="text-medium" is-pk="true"/>
    <field name="siteId" type="id"/>
    <field name="canonical" type="text-indicator"/>
    <relationship type="one" related="mantle.public.PublicSite"/>
  </entity>
  <entity entity-name="PublicSiteApp" package="mantle.public">
    <field name="siteId" type="id" is-pk="true"/>
    <field name="appMountId" type="id" is-pk="true"/>
    <field name="app" type="id"/>
    <field name="pathPrefix" type="text-medium"/>
    <field name="enabled" type="text-indicator"/>
    <field name="targetId" type="id"/>
    <relationship type="one" related="mantle.public.PublicSite"/>
  </entity>
  <entity entity-name="PublicSiteParty" package="mantle.public">
    <field name="siteId" type="id" is-pk="true"/>
    <field name="partyId" type="id" is-pk="true"/>
    <field name="state" type="id"/>
    <field name="role" type="id"/>
    <field name="joinedAt" type="date-time"/>
    <field name="fromDate" type="date-time"/>
    <field name="thruDate" type="date-time"/>
    <field name="revision" type="number-integer"/>
    <field name="guidelinesRevision" type="number-integer"/>
    <field name="stateSetByPartyId" type="id"><description>Who last set state: the member (leave/join) or staff; staff suspensions and removals cannot be undone by rejoining.</description></field>
    <relationship type="one" related="mantle.public.PublicSite"/>
    <relationship type="one" related="mantle.party.Party"/>
    <index name="PASS_SITE_MEMBER_PAGE">
      <index-field name="siteId"/>
      <index-field name="state"/>
      <index-field name="partyId"/>
    </index>
  </entity>
  <entity entity-name="PublicSiteProfile" package="mantle.public">
    <field name="siteId" type="id" is-pk="true"/>
    <field name="partyId" type="id" is-pk="true"/>
    <field name="handle" type="text-medium"/>
    <field name="displayName" type="text-medium"/>
    <field name="avatarId" type="id"/>
    <field name="bio" type="text-long"/>
    <field name="discoverability" type="id"/>
    <field name="locale" type="id"/>
    <field name="timeZone" type="id"/>
    <field name="revision" type="number-integer"/>
    <relationship type="one" related="mantle.public.PublicSite"/>
    <relationship type="one" related="mantle.party.Party"/>
    <index name="PASS_PROFILE_HANDLE" unique="true">
      <index-field name="siteId"/>
      <index-field name="handle"/>
    </index>
    <index name="PASS_PROFILE_AVATAR">
      <index-field name="siteId"/>
      <index-field name="avatarId"/>
    </index>
  </entity>
  <entity entity-name="PublicSiteInvitation" package="mantle.public">
    <field name="invitationId" type="id" is-pk="true"/>
    <field name="tokenHash" type="text-medium"/>
    <field name="siteId" type="id"/>
    <field name="emailHash" type="text-medium"/>
    <field name="scopes" type="text-long"/>
    <field name="inviterPartyId" type="id"/>
    <field name="expiresAt" type="date-time"/>
    <field name="redeemedAt" type="date-time"/>
    <field name="revokedAt" type="date-time"/>
    <relationship type="one" related="mantle.public.PublicSite"/>
    <index name="PASS_INVITE_HASH" unique="true">
      <index-field name="tokenHash"/>
    </index>
  </entity>
  <entity entity-name="PublicSitePage" package="mantle.public">
    <field name="siteId" type="id" is-pk="true"/>
    <field name="pageRole" type="id" is-pk="true"/>
    <field name="wikiPageId" type="id"/>
    <field name="versionName" type="id"/>
    <field name="publicationRevision" type="number-integer"/>
    <relationship type="one" related="mantle.public.PublicSite"/>
    <relationship type="one" related="moqui.resource.wiki.WikiPage"/>
  </entity>
  <entity entity-name="PublicAccessGrant" package="mantle.public">
    <field name="grantId" type="id" is-pk="true"/>
    <field name="partyId" type="id"/>
    <field name="siteId" type="id"/>
    <field name="targetType" type="id"/>
    <field name="targetId" type="id"/>
    <field name="sourceType" type="id"/>
    <field name="sourceId" type="id"/>
    <field name="fromDate" type="date-time"/>
    <field name="thruDate" type="date-time"/>
    <field name="revokedAt" type="date-time"/>
    <field name="reason" type="text-medium"/>
    <field name="grantedByPartyId" type="id"><description>Staff member for a manual grant; empty for a grant a subscription lifecycle made.</description></field>
    <field name="createdAt" type="date-time"/>
    <field name="revision" type="number-integer"/>
    <relationship type="one" related="mantle.public.PublicSite"/>
    <relationship type="one" related="mantle.party.Party"/>
    <index name="PASS_GRANT_SOURCE" unique="true">
      <index-field name="partyId"/>
      <index-field name="siteId"/>
      <index-field name="targetType"/>
      <index-field name="targetId"/>
      <index-field name="sourceType"/>
      <index-field name="sourceId"/>
    </index>
    <index name="PASS_GRANT_SITE">
      <index-field name="siteId"/>
      <index-field name="targetType"/>
      <index-field name="targetId"/>
      <index-field name="thruDate"/>
    </index>
  </entity>
  <entity entity-name="PublicSubscriptionBinding" package="mantle.public">
    <description>The site or category scope a subscription resource grants. Its handlers write source-bound PublicAccessGrant rows.</description>
    <field name="subscriptionResourceId" type="id" is-pk="true"/>
    <field name="siteId" type="id"/>
    <field name="targetType" type="id"/>
    <field name="targetId" type="id"/>
    <field name="createdAt" type="date-time"/>
    <field name="revision" type="number-integer"/>
    <relationship type="one" related="mantle.public.PublicSite"/>
    <relationship type="one" related="mantle.product.subscription.SubscriptionResource"/>
  </entity>
</entities>
