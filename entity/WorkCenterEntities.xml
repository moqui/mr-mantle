<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <entity entity-name="WorkCenter" package="mantle.work.production">
        <description>Production extension of a Facility. Capacity, alternates and load remain Manufacturing work.</description>
        <field name="facilityId" type="id" is-pk="true"/>
        <field name="calendarId" type="id" enable-audit-log="true"/>
        <field name="efficiencyPercent" type="number-decimal" enable-audit-log="true"/>
        <field name="oeeTargetPercent" type="number-decimal" enable-audit-log="true"/>
        <field name="changeReason" type="text-medium" enable-audit-log="true"/>
        <relationship type="one" related="mantle.facility.Facility"/>
    </entity>
    <entity entity-name="WorkCenterRate" package="mantle.work.production">
        <description>An approved hourly cost policy is a dated row; money is independently guarded and audit-logged.</description>
        <field name="workCenterRateId" type="id" is-pk="true"/>
        <field name="facilityId" type="id" enable-audit-log="true"/>
        <field name="componentTypeEnumId" type="id" enable-audit-log="true"/>
        <field name="rateAmount" type="currency-precise" enable-audit-log="true"/>
        <field name="priceUomId" type="id" enable-audit-log="true"/>
        <field name="fromDate" type="date-time" enable-audit-log="true"/>
        <field name="thruDate" type="date-time" enable-audit-log="true"/>
        <field name="state" type="text-short" enable-audit-log="true"/>
        <field name="approvedDate" type="date-time" enable-audit-log="true"/>
        <field name="approvedByUserId" type="id" enable-audit-log="true"/>
        <field name="changeReason" type="text-medium" enable-audit-log="true"/>
        <relationship type="one" related="mantle.work.production.WorkCenter"/>
        <relationship type="one" title="Currency" related="moqui.basic.Uom"><key-map field-name="priceUomId" related="uomId"/></relationship>
    </entity>
</entities>
