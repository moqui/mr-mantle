<?xml version="1.0" ?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <extend-entity entity-name="PartyAcctgPreference" package="mantle.ledger.config">
        <field name="inventoryRevaluationEnabled" type="text-indicator" default="'N'" enable-audit-log="update"/>
    </extend-entity>
    <entity entity-name="AssetBookEvent" package="mantle.product.asset" cache="never" create-only="true">
        <description>An Accounting book fact with ledger links. Revaluation changes the forward inventory cost without reposting historical movements. Partly issued assets are split to preserve the old asset and its posted history.</description>
        <field name="assetBookEventId" type="id" is-pk="true"/>
        <field name="assetId" type="id" enable-audit-log="true"/>
        <field name="sourceAssetId" type="id" enable-audit-log="true"/>
        <field name="unitCostUomId" type="id" enable-audit-log="true"/>
        <field name="productId" type="id" enable-audit-log="true"/>
        <field name="organizationPartyId" type="id" enable-audit-log="true"/>
        <field name="facilityId" type="id" enable-audit-log="true"/>
        <field name="eventTypeEnumId" type="id" enable-audit-log="true"/>
        <field name="eventDate" type="date-time" enable-audit-log="true"/>
        <field name="quantity" type="number-decimal" enable-audit-log="true"/>
        <field name="quantityUomId" type="id" enable-audit-log="true"/>
        <field name="previousUnitCost" type="currency-precise" enable-audit-log="true"/>
        <field name="newUnitCost" type="currency-precise" enable-audit-log="true"/>
        <field name="amount" type="currency-amount" enable-audit-log="true"/>
        <field name="amountUomId" type="id" enable-audit-log="true"/>
        <field name="productStandardCostId" type="id" enable-audit-log="true"/>
        <field name="acctgTransId" type="id" enable-audit-log="true"/>
        <field name="assetGlAccountId" type="id" enable-audit-log="true"/>
        <field name="offsetGlAccountId" type="id" enable-audit-log="true"/>
        <field name="reversalOfAssetBookEventId" type="id" enable-audit-log="true"/>
        <field name="operationKey" type="id" enable-audit-log="true"/>
        <field name="postedByUserId" type="id" enable-audit-log="true"/>
        <field name="postedDate" type="date-time" enable-audit-log="true"/>
        <field name="changeReason" type="text-medium" enable-audit-log="true"/>
        <relationship type="one" related="mantle.product.asset.Asset">
            <key-map field-name="assetId" related="assetId"/>
        </relationship>
        <relationship type="one" related="mantle.product.cost.ProductStandardCost">
            <key-map field-name="productStandardCostId" related="productStandardCostId"/>
        </relationship>
        <relationship type="one" related="mantle.ledger.transaction.AcctgTrans">
            <key-map field-name="acctgTransId" related="acctgTransId"/>
        </relationship>
    </entity>
    <entity entity-name="AssetRevaluationPreview" package="mantle.product.asset" cache="never">
        <description>The exact reviewed revaluation scope and input fingerprint. Posting recomputes and locks those inputs; the preview is not a second stock ledger.</description>
        <field name="previewId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id" enable-audit-log="true"/>
        <field name="productId" type="id" enable-audit-log="true"/>
        <field name="facilityId" type="id" enable-audit-log="true"/>
        <field name="productStandardCostId" type="id" enable-audit-log="true"/>
        <field name="userId" type="id" enable-audit-log="true"/>
        <field name="createdDate" type="date-time" enable-audit-log="true"/>
        <field name="expiresDate" type="date-time" enable-audit-log="true"/>
        <field name="requestJson" type="text-very-long" enable-audit-log="true"/>
        <field name="inputFingerprint" type="text-long" enable-audit-log="true"/>
        <field name="complete" type="text-indicator" enable-audit-log="true"/>
        <field name="postedAcctgTransId" type="id" enable-audit-log="true"/>
    </entity>
    <entity entity-name="PostingOperation" package="mantle.ledger.transaction" cache="never">
        <description>The shared CX-POSTING transaction boundary: one operation key and request hash, checked and stored in the posting transaction. Identical retries return the stored result; changed requests are refused.</description>
        <field name="operationKey" type="id" is-pk="true"/>
        <field name="operationType" type="text-short" enable-audit-log="true"/>
        <field name="organizationPartyId" type="id" enable-audit-log="true"/>
        <field name="userId" type="id" enable-audit-log="true"/>
        <field name="submittedDate" type="date-time" enable-audit-log="true"/>
        <field name="requestHash" type="text-long" enable-audit-log="true"/>
        <field name="previewId" type="id" enable-audit-log="true"/>
        <field name="previewFingerprint" type="text-long" enable-audit-log="true"/>
        <field name="status" type="text-short" enable-audit-log="true"/>
        <field name="resultEntityName" type="text-medium" enable-audit-log="true"/>
        <field name="resultId" type="id" enable-audit-log="true"/>
        <field name="completedDate" type="date-time" enable-audit-log="true"/>
    </entity>
</entities>
