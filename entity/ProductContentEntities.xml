<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <extend-entity entity-name="ProductContent" package="mantle.product">
        <field name="sourceProductContentId" type="id" enable-audit-log="true"/>
        <field name="reviewedSourceRevision" type="text-long" enable-audit-log="true"/>
        <field name="reviewedByUserId" type="id" enable-audit-log="true"/>
        <field name="reviewedDate" type="date-time" enable-audit-log="true"/>
    </extend-entity>
    <extend-entity entity-name="ProductCategoryContent" package="mantle.product.category">
        <field name="sourceProductCategoryContentId" type="id" enable-audit-log="true"/>
        <field name="reviewedSourceRevision" type="text-long" enable-audit-log="true"/>
        <field name="reviewedByUserId" type="id" enable-audit-log="true"/>
        <field name="reviewedDate" type="date-time" enable-audit-log="true"/>
    </extend-entity>
    <entity entity-name="ContentEditConflict" package="mantle.product" cache="never" create-only="true">
        <description>A retained edit submitted against an older content revision. The current resource remains unchanged; this separate draft may be downloaded and reconciled.</description>
        <field name="contentEditConflictId" type="id" is-pk="true"/>
        <field name="contentEntityName" type="text-medium"/>
        <field name="contentId" type="id"/>
        <field name="expectedRevision" type="text-long"/>
        <field name="currentRevision" type="text-long"/>
        <field name="draftLocation" type="text-medium"/>
        <field name="submittedMetadataJson" type="text-very-long"/>
        <field name="submittedByUserId" type="id"/>
        <field name="submittedDate" type="date-time"/>
    </entity>
</entities>
