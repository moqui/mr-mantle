<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <extend-entity entity-name="Payment" package="mantle.account.payment">
        <field name="overrideTypeGlAccountId" type="id"><description>Overrides the GlAccount for the payment type entry of an
            unapplied payment, the other side of the PaymentMethod entry: the expense account of a charge paid without an
            invoice, such as the fee of an internal transfer.</description></field>
        <relationship type="one" title="OverrideType" related="mantle.ledger.account.GlAccount" short-alias="overrideTypeGlAccount">
            <key-map field-name="overrideTypeGlAccountId"/></relationship>
    </extend-entity>
</entities>
