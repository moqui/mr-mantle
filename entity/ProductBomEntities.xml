<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <entity entity-name="ProductBom" package="mantle.product.bom">
        <description>A product/org/method record and Files host. Approved header values are read through the release decision’s audit references.</description>
        <field name="productBomId" type="id" is-pk="true"/>
        <field name="productId" type="id" enable-audit-log="true"/>
        <field name="organizationPartyId" type="id" enable-audit-log="true"/>
        <field name="legacyImportComplete" type="text-indicator" enable-audit-log="true"/>
        <field name="legacyImportIssuesJson" type="text-long" enable-audit-log="true"/>
        <field name="methodCode" type="text-short" enable-audit-log="true"/>
        <field name="bomName" type="text-medium" enable-audit-log="true"/>
        <field name="baseQuantity" type="number-decimal" enable-audit-log="true"/>
        <field name="quantityUomId" type="id" enable-audit-log="true"/>
        <field name="isPhantom" type="text-indicator" enable-audit-log="true"/>
        <field name="routingWorkEffortId" type="id" enable-audit-log="true"/>
        <field name="leadTimeDays" type="number-decimal" enable-audit-log="true"/>
        <field name="prepareDays" type="number-decimal" enable-audit-log="true"/>
        <field name="changeReason" type="text-medium" enable-audit-log="true"/>
        <relationship type="one" related="mantle.product.Product"/>
        <relationship type="one" related="mantle.party.Party"><key-map field-name="organizationPartyId" related="partyId"/></relationship>
        <relationship type="one" title="Quantity" related="moqui.basic.Uom"><key-map field-name="quantityUomId" related="uomId"/></relationship>
        <relationship type="one" title="Routing" related="mantle.work.effort.WorkEffort"><key-map field-name="routingWorkEffortId" related="workEffortId"/></relationship>
        <index name="PRDBOM_ORG_METHOD" unique="true"><index-field name="productId"/><index-field name="organizationPartyId"/><index-field name="methodCode"/></index>
    </entity>
    <entity entity-name="ProductBomItem" package="mantle.product.bom">
        <description>A material/output requirement has its own stable ID, including while draft and when referenced by an issuance. A correction stages a new dated replacement linked to its predecessor; released values are immutable.</description>
        <field name="bomItemId" type="id" is-pk="true"/>
        <field name="productBomId" type="id" enable-audit-log="true"/>
        <field name="replacesBomItemId" type="id" enable-audit-log="true"/>
        <field name="componentProductBomId" type="id" enable-audit-log="true"/>
        <field name="productId" type="id" enable-audit-log="true"/>
        <field name="roleEnumId" type="id" enable-audit-log="true"/>
        <field name="quantity" type="number-decimal" enable-audit-log="true"/>
        <field name="quantityUomId" type="id" enable-audit-log="true"/>
        <field name="scrapFactor" type="number-decimal" enable-audit-log="true"/>
        <field name="operationWorkEffortId" type="id" enable-audit-log="true"/>
        <field name="sequenceNum" type="number-integer" enable-audit-log="true"/>
        <field name="applicabilityFeatureIds" type="text-long" enable-audit-log="true"/>
        <field name="instruction" type="text-long" enable-audit-log="true"/>
        <field name="substitutionRuleEnumId" type="id" enable-audit-log="true"/>
        <field name="allocationShare" type="number-decimal" enable-audit-log="true"/>
        <field name="state" type="text-short" enable-audit-log="true"/>
        <field name="removeOnRelease" type="text-indicator" enable-audit-log="true"/>
        <field name="fromDate" type="date-time" enable-audit-log="true"/>
        <field name="thruDate" type="date-time" enable-audit-log="true"/>
        <field name="legacyAssocKey" type="text-long" enable-audit-log="true"/>
        <field name="changeReason" type="text-medium" enable-audit-log="true"/>
        <relationship type="one" related="mantle.product.bom.ProductBom"/>
        <relationship type="one" related="mantle.product.Product"/>
        <relationship type="one-nofk" title="Replaces" related="mantle.product.bom.ProductBomItem"><key-map field-name="replacesBomItemId" related="bomItemId"/></relationship>
        <relationship type="one-nofk" title="Component" related="mantle.product.bom.ProductBom"><key-map field-name="componentProductBomId" related="productBomId"/></relationship>
        <relationship type="one-nofk" title="Operation" related="mantle.work.effort.WorkEffort"><key-map field-name="operationWorkEffortId" related="workEffortId"/></relationship>
        <relationship type="one" title="Quantity" related="moqui.basic.Uom"><key-map field-name="quantityUomId" related="uomId"/></relationship>
    </entity>
    <entity entity-name="ProductBomContent" package="mantle.product.bom">
        <field name="productBomContentId" type="id" is-pk="true"/>
        <field name="productBomId" type="id" enable-audit-log="true"/>
        <field name="productBomContentTypeEnumId" type="id" enable-audit-log="true"/>
        <field name="description" type="text-medium" enable-audit-log="true"/>
        <field name="contentLocation" type="text-long" enable-audit-log="true"/>
        <field name="locale" type="text-short" enable-audit-log="true"/>
        <field name="fromDate" type="date-time" enable-audit-log="true"/>
        <field name="thruDate" type="date-time" enable-audit-log="true"/>
        <field name="userId" type="id" enable-audit-log="true"/>
        <relationship type="one" related="mantle.product.bom.ProductBom"/>
    </entity>
    <entity entity-name="MethodReleaseDecision" package="mantle.work.method" create-only="true">
        <description>An approval fact, not a method version. Audit references identify the values approved; stamped line facts are its children.</description>
        <field name="methodReleaseDecisionId" type="id" is-pk="true"/>
        <field name="methodEntityName" type="text-medium" enable-audit-log="true"/>
        <field name="methodId" type="id" enable-audit-log="true"/>
        <field name="fromDate" type="date-time" enable-audit-log="true"/>
        <field name="approvedDate" type="date-time" enable-audit-log="true"/>
        <field name="approvedByUserId" type="id" enable-audit-log="true"/>
        <field name="changeReason" type="text-medium" enable-audit-log="true"/>
        <field name="inputFingerprint" type="text-long" enable-audit-log="true"/>
        <field name="auditRefsJson" type="text-very-long" enable-audit-log="true"/>
    </entity>
    <entity entity-name="MethodReleaseItem" package="mantle.work.method" create-only="true">
        <field name="methodReleaseDecisionId" type="id" is-pk="true"/>
        <field name="itemSeqId" type="number-integer" is-pk="true"/>
        <field name="lineEntityName" type="text-medium" enable-audit-log="true"/>
        <field name="lineId" type="id" enable-audit-log="true"/>
        <field name="action" type="text-short" enable-audit-log="true"/>
        <field name="fromDate" type="date-time" enable-audit-log="true"/>
        <field name="previousFromDate" type="date-time" enable-audit-log="true"/>
        <relationship type="one" related="mantle.work.method.MethodReleaseDecision"/>
    </entity>
</entities>
