<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    <entity entity-name="PaymentValidationPublication" package="mantle.account.payment" cache="never">
        <field name="validationEventId" type="id" is-pk="true"/>
        <field name="organizationPartyId" type="id"/>
        <field name="paymentId" type="id"/>
        <field name="sourceVersion" type="text-long"/>
        <field name="status" type="text-short"/>
        <field name="createdDate" type="date-time"/>
        <field name="lastAttemptDate" type="date-time"/>
        <field name="lastError" type="text-long"/>
        <index name="PAYMENT_NOTICE_PENDING"><index-field name="status"/><index-field name="createdDate"/></index>
    </entity>
    <entity entity-name="PaymentValidationDelivery" package="mantle.account.payment" cache="never">
        <field name="validationEventId" type="id" is-pk="true"/>
        <field name="userId" type="id" is-pk="true"/>
        <field name="notificationMessageId" type="id"/>
        <field name="status" type="text-short"/>
        <field name="lastAttemptDate" type="date-time"/>
        <field name="lastError" type="text-long"/>
    </entity>
</entities>
