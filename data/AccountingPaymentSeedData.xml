<entity-facade-xml type="seed">
    <!-- An internal transfer is one payment from the organization to itself, from one of its cash methods to another,
        posted through the PtInternalTransfer transit accounts of PaymentTypeGlAccount (ZaaGlAccountsInstallData). -->
    <moqui.basic.Enumeration enumId="PtInternalTransfer" enumTypeId="PaymentType" description="Internal Transfer"/>

    <!-- Payment reviews (PaymentReview): what a review is of, and the reason code prefix of its refusals (optionValue). -->
    <moqui.basic.EnumerationType enumTypeId="PaymentReviewKind" description="Payment Review Kind"/>
    <moqui.basic.Enumeration enumId="PrkSettlement" enumTypeId="PaymentReviewKind" enumCode="manual" optionValue="SETTLEMENT"
            sequenceNum="1" description="Settlement"/>
    <moqui.basic.Enumeration enumId="PrkAutoApply" enumTypeId="PaymentReviewKind" enumCode="auto" optionValue="SETTLEMENT"
            sequenceNum="2" description="Automatic Application"/>
    <moqui.basic.Enumeration enumId="PrkSettlementDraft" enumTypeId="PaymentReviewKind" enumCode="draft"
            optionValue="SETTLEMENT" sequenceNum="3" description="Settlement Draft"/>
    <moqui.basic.Enumeration enumId="PrkState" enumTypeId="PaymentReviewKind" enumCode="state" optionValue="PAYMENT"
            sequenceNum="4" description="Payment State Change"/>
    <moqui.basic.Enumeration enumId="PrkUnapply" enumTypeId="PaymentReviewKind" enumCode="unapply" optionValue="PAYMENT"
            sequenceNum="5" description="Payment Unapplication"/>
    <moqui.basic.Enumeration enumId="PrkGateway" enumTypeId="PaymentReviewKind" enumCode="gateway" optionValue="GATEWAY"
            sequenceNum="6" description="Gateway Action"/>
    <moqui.basic.Enumeration enumId="PrkRefund" enumTypeId="PaymentReviewKind" enumCode="refund" optionValue="REFUND"
            sequenceNum="7" description="Refund"/>
    <moqui.basic.Enumeration enumId="PrkTransfer" enumTypeId="PaymentReviewKind" enumCode="transfer" optionValue="TRANSFER"
            sequenceNum="8" description="Internal Transfer"/>
    <moqui.basic.StatusType statusTypeId="PaymentReview" description="Payment Review"/>
    <moqui.basic.StatusItem statusId="PrvDraft" statusTypeId="PaymentReview" statusCode="draft" sequenceNum="1"
            description="Draft"/>
    <moqui.basic.StatusItem statusId="PrvReview" statusTypeId="PaymentReview" statusCode="review" sequenceNum="2"
            description="In Review"/>
    <moqui.basic.StatusItem statusId="PrvComplete" statusTypeId="PaymentReview" statusCode="complete" sequenceNum="3"
            description="Confirmed"/>
    <moqui.basic.StatusFlowTransition statusFlowId="Default" statusId="PrvReview" toStatusId="PrvComplete"
            transitionName="Confirm"/>
</entity-facade-xml>
