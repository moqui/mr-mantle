<?xml version='1.0' encoding='utf-8'?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="validate" noun="Catalog" allow-remote="false">
        <in-parameters>
            <parameter name="organizationPartyId" type="String" />
            <parameter name="productIds" type="List" />
            <parameter name="candidateProducts" type="List" />
            <parameter name="productCategoryId" type="String" />
            <parameter name="includeDescendants" type="Boolean" />
            <parameter name="asOfDate" type="Timestamp" />
            <parameter name="checkIds" type="List" />
            <parameter name="includeInactive" type="Boolean" />
        </in-parameters>
        <out-parameters>
            <parameter name="issueRows" type="List" />
            <parameter name="checkOptions" type="List" />
            <parameter name="checkedCount" type="Integer" />
            <parameter name="issueCount" type="Integer" />
            <parameter name="incompleteCount" type="Integer" />
            <parameter name="missingPriceCount" type="Integer" />
            <parameter name="valid" type="Boolean" />
            <parameter name="asOfDate" type="Timestamp" />
        </out-parameters>
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/product/CatalogChecks.js').validate(context))</script>
        </actions>
    </service>
    <service verb="get" noun="CatalogChecks" allow-remote="false">
        <in-parameters />
        <out-parameters>
            <parameter name="checkOptions" type="List" />
        </out-parameters>
        <actions>
            <script>ec.resource.script('component://mr-mantle/service/mantle/product/CatalogPolicy.js').scope(context);checkOptions=ec.resource.script('component://mr-mantle/service/mantle/product/CatalogChecks.js').options()</script>
        </actions>
    </service>
</services>