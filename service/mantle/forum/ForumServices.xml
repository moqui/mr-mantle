  <service verb="remind" noun="Bookmarks" authenticate="false" allow-remote="false">
    <description>Worker: due bookmark reminders become in-app notices, each in its own transaction.</description>
    <out-parameters>
      <parameter name="result" type="Map"/>
    </out-parameters>
    <actions>
      <script><![CDATA[
        const was=ec.artifactExecution.disableAuthz()
        try{result=ec.resource.script('component://mr-mantle/service/mantle/forum/Forum.js').remindBookmarks()}finally{if(!was)ec.artifactExecution.enableAuthz()}
      ]]></script>
    </actions>
  </service>
  <service verb="remind" noun="Bookmark" authenticate="false" allow-remote="false">
    <in-parameters>
      <parameter name="bookmarkId" required="true"/>
    </in-parameters>
    <out-parameters>
      <parameter name="result" type="Map"/>
    </out-parameters>
    <actions>
      <script><![CDATA[
        const was=ec.artifactExecution.disableAuthz()
        try{result=ec.resource.script('component://mr-mantle/service/mantle/forum/Forum.js').remindBookmark(bookmarkId)}finally{if(!was)ec.artifactExecution.enableAuthz()}
      ]]></script>
    </actions>
  </service>
