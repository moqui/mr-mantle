<!-- Subscription resource handlers for site and category access. store#SubscriptionBinding names them on a bound
     SubscriptionResource; the subscription lifecycle (order approval, expire#SubscriptionAccess) calls them. They write
     source-bound PublicAccessGrant rows and never add a UserGroup or a site role. Internal only: no public route. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
  <service verb="init" noun="ForumAccess" authenticate="false" allow-remote="false">
    <implements service="mantle.product.SubscriptionServices.init#SubscriptionResource"/>
    <actions>
      <script>ec.resource.script('component://mr-mantle/service/mantle/forum/Forum.js').applySubscription('init', subscriptionId)</script>
    </actions>
  </service>
  <service verb="renew" noun="ForumAccess" authenticate="false" allow-remote="false">
    <implements service="mantle.product.SubscriptionServices.renew#SubscriptionResourceAccess"/>
    <actions>
      <script>ec.resource.script('component://mr-mantle/service/mantle/forum/Forum.js').applySubscription('renew', subscriptionId)</script>
    </actions>
  </service>
  <service verb="revoke" noun="ForumAccess" authenticate="false" allow-remote="false">
    <implements service="mantle.product.SubscriptionServices.revoke#SubscriptionResourceAccess"/>
    <actions>
      <script>ec.resource.script('component://mr-mantle/service/mantle/forum/Forum.js').applySubscription('revoke', subscriptionId)</script>
    </actions>
  </service>
  <service verb="restore" noun="ForumAccess" authenticate="false" allow-remote="false">
    <implements service="mantle.product.SubscriptionServices.restore#SubscriptionResourceAccess"/>
    <actions>
      <script>ec.resource.script('component://mr-mantle/service/mantle/forum/Forum.js').applySubscription('restore', subscriptionId)</script>
    </actions>
  </service>
  <service verb="destroy" noun="ForumAccess" authenticate="false" allow-remote="false">
    <implements service="mantle.product.SubscriptionServices.destroy#SubscriptionResource"/>
    <actions>
      <script>ec.resource.script('component://mr-mantle/service/mantle/forum/Forum.js').applySubscription('destroy', subscriptionId)</script>
    </actions>
  </service>
</services>
