<!-- Backend-only moderation workers. They have no public routes; each item runs in its own transaction. -->
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
  <service verb="recompute" noun="Trust" authenticate="false" allow-remote="false">
    <description>Promote members whose measured reading and contributions meet their site's trust thresholds, checkpointed in pages.</description>
    <out-parameters>
      <parameter name="result" type="Map"/>
    </out-parameters>
    <actions>
      <script><![CDATA[
        const was=ec.artifactExecution.disableAuthz()
        try{result=ec.resource.script('component://mr-mantle/service/mantle/forum/Forum.js').recomputeTrust()}finally{if(!was)ec.artifactExecution.enableAuthz()}
      ]]></script>
    </actions>
  </service>
  <service verb="recompute" noun="MemberTrust" authenticate="false" allow-remote="false">
    <in-parameters>
      <parameter name="siteId" required="true"/>
      <parameter name="partyId" required="true"/>
    </in-parameters>
    <out-parameters>
      <parameter name="result" type="Map"/>
    </out-parameters>
    <actions>
      <script><![CDATA[
        const was=ec.artifactExecution.disableAuthz()
        try{result=ec.resource.script('component://mr-mantle/service/mantle/forum/Forum.js').recomputeMemberTrust(siteId,partyId)}finally{if(!was)ec.artifactExecution.enableAuthz()}
      ]]></script>
    </actions>
  </service>
  <service verb="classify" noun="Posts" authenticate="false" allow-remote="false">
    <description>Send queued posts to the operator-configured classifier (pass_classifier_service); results only file review items.</description>
    <out-parameters>
      <parameter name="result" type="Map"/>
    </out-parameters>
    <actions>
      <script><![CDATA[
        const was=ec.artifactExecution.disableAuthz()
        try{result=ec.resource.script('component://mr-mantle/service/mantle/forum/Forum.js').classifyPosts()}finally{if(!was)ec.artifactExecution.enableAuthz()}
      ]]></script>
    </actions>
  </service>
  <service verb="classify" noun="Post" authenticate="false" allow-remote="false">
    <in-parameters>
      <parameter name="outboxId" required="true"/>
    </in-parameters>
    <out-parameters>
      <parameter name="result" type="Map"/>
    </out-parameters>
    <actions>
      <script><![CDATA[
        const was=ec.artifactExecution.disableAuthz()
        try{result=ec.resource.script('component://mr-mantle/service/mantle/forum/Forum.js').classifyPost(outboxId)}finally{if(!was)ec.artifactExecution.enableAuthz()}
      ]]></script>
    </actions>
  </service>
  <service verb="fire" noun="TopicTimers" authenticate="false" allow-remote="false">
    <description>Apply due topic timers after rechecking each topic's scope and the timer creator's moderation access.</description>
    <out-parameters>
      <parameter name="result" type="Map"/>
    </out-parameters>
    <actions>
      <script><![CDATA[
        const was=ec.artifactExecution.disableAuthz()
        try{result=ec.resource.script('component://mr-mantle/service/mantle/forum/Forum.js').fireTimers()}finally{if(!was)ec.artifactExecution.enableAuthz()}
      ]]></script>
    </actions>
  </service>
  <service verb="fire" noun="TopicTimer" authenticate="false" allow-remote="false">
    <in-parameters>
      <parameter name="timerId" required="true"/>
    </in-parameters>
    <out-parameters>
      <parameter name="result" type="Map"/>
    </out-parameters>
    <actions>
      <script><![CDATA[
        const was=ec.artifactExecution.disableAuthz()
        try{result=ec.resource.script('component://mr-mantle/service/mantle/forum/Forum.js').fireTimer(timerId)}finally{if(!was)ec.artifactExecution.enableAuthz()}
      ]]></script>
    </actions>
  </service>
</services>
