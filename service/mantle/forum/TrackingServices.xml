<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
  <service verb="refresh" noun="Mode" authenticate="false" allow-remote="false">
    <in-parameters>
      <parameter name="userId" required="true"/>
      <parameter name="force" type="Boolean"/>
    </in-parameters>
    <out-parameters>
      <parameter name="result" type="Map"/>
    </out-parameters>
    <actions>
      <script>result=ec.resource.script('component://mr-mantle/service/mantle/forum/Tracking.js').execute('refresh',{userId,force})</script>
    </actions>
  </service>
  <service verb="convert" noun="Root" authenticate="false" allow-remote="false">
    <in-parameters>
      <parameter name="runId" required="true"/>
      <parameter name="rootCommEventId" required="true"/>
    </in-parameters>
    <out-parameters>
      <parameter name="result" type="Map"/>
    </out-parameters>
    <actions>
      <script>result=ec.resource.script('component://mr-mantle/service/mantle/forum/Tracking.js').execute('root',{runId,rootCommEventId})</script>
    </actions>
  </service>
  <service verb="dispatch" noun="Conversions" authenticate="false" allow-remote="false">
    <out-parameters>
      <parameter name="result" type="Map"/>
    </out-parameters>
    <actions>
      <script>result=ec.resource.script('component://mr-mantle/service/mantle/forum/Tracking.js').execute('dispatch',{})</script>
    </actions>
  </service>
</services>
