<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="send" noun="PaymentValidationNotice" allow-remote="false" authenticate="anonymous-all">
        <description>Send the PaymentValidation notification of a proposed payment to the topic's subscribers, after its
            draft commits (PaymentValidation.secas.xml). The message carries the revision to validate; a recipient
            approves or refuses it with approve#/refuse#PaymentValidationNotice. Sends nothing for a payment no longer
            proposed. It runs after commit without a user; the sender is the user who proposed the payment.</description>
        <in-parameters>
            <parameter name="paymentId" required="true"/>
            <parameter name="validationEventId" required="true"/>
            <parameter name="sourceVersion" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="notificationMessageId"/>
        </out-parameters>
        <actions>
            <entity-find-one entity-name="mantle.account.payment.Payment" value-field="payment" disable-authz="true"/>
            <if condition="payment == null || payment.statusId != 'PmntProposed'">
                <return/>
            </if>
            <entity-find-one entity-name="mantle.account.payment.PaymentLifecycleEvent" value-field="validationEvent"
                    disable-authz="true">
                <field-map field-name="paymentLifecycleEventId" from="validationEventId"/>
            </entity-find-one>
            <set field="message" from="{
                    paymentId:paymentId, organizationPartyId:validationEvent?.organizationPartyId,
                    validationEventId:validationEventId, sourceVersion:sourceVersion,
                    amount:String(payment.amount ?? 0), currencyUomId:payment.amountUomId}"/>
            <script><![CDATA[
                const notification = ec.makeNotificationMessage().topic('PaymentValidation').message(message)
                    .record('mantle.account.payment.Payment', paymentId).actorUserId(validationEvent?.userId)
                notification.send()
                notificationMessageId = notification.getNotificationMessageId()
            ]]></script>
        </actions>
    </service>
</services>
