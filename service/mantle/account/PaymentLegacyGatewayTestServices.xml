<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="authorize" noun="ManualPayment" allow-remote="false">
        <description>Explicit legacy-interface fixture: manual instruments with an explicit provider are supported old inputs.</description>
        <implements service="mantle.account.PaymentServices.authorize#Payment"/>
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/test/AccountingLegacyGatewayFixture.js').provider(context))</script>
        </actions>
    </service>
    <service verb="store" noun="Probe" transaction="force-new" allow-remote="false">
        <description>Commit test coordination or provider effect independently of the calling financial transaction.</description>
        <in-parameters>
            <parameter name="paymentId" required="true"/>
            <parameter name="values" type="Map"/>
            <parameter name="incrementEffect" type="Boolean"/>
        </in-parameters>
        <out-parameters>
            <parameter name="complete" type="Boolean"/>
        </out-parameters>
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/test/AccountingLegacyGatewayFixture.js').storeProbe(context))</script>
        </actions>
    </service>
    <service verb="rollback" noun="ProviderCall" allow-remote="false">
        <description>Hold the original Payment as a legacy wrapper does; provider side effects and admission survive outer rollback.</description>
        <in-parameters>
            <parameter name="paymentId" required="true"/>
            <parameter name="paymentGatewayConfigId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="complete" type="Boolean"/>
        </out-parameters>
        <actions>
            <script>ec.resource.script('component://mr-mantle/test/AccountingLegacyGatewayFixture.js').rollbackProvider(context)</script>
        </actions>
    </service>
    <service verb="hold" noun="NativeAdoption" allow-remote="false">
        <description>Retain the real native store's organization, Payment and admission locks until a competing legacy request has waited.</description>
        <in-parameters>
            <parameter name="request" type="Map" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="blocked" type="Boolean"/>
        </out-parameters>
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/test/AccountingLegacyGatewayFixture.js').holdAdoption(context))</script>
        </actions>
    </service>
</services>
