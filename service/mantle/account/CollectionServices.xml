<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="define" noun="StatementParameters" type="interface">
        <description>Shared authorized statement selection, reviewed snapshot and independent delivery parameters.</description>
        <in-parameters>
            <parameter name="organizationPartyId"/>
            <parameter name="customerPartyIdList" type="List"/>
            <parameter name="fromDate" type="Timestamp"/>
            <parameter name="asOfDate" type="Timestamp"/>
            <parameter name="currencyUomId"/>
            <parameter name="includeZeroBalance" type="Boolean"/>
            <parameter name="snapshotId"/>
            <parameter name="inputFingerprint"/>
            <parameter name="operationKey"/>
            <parameter name="emailAccountId"/>
            <parameter name="toAddresses"/>
            <parameter name="customerPartyId"/>
            <parameter name="recipient"/>
            <parameter name="requestHash"/>
            <parameter name="result" type="Map"/>
        </in-parameters>
    </service>
    <service verb="preview" noun="Statements" allow-remote="false">
        <description>Freeze authorized customer statements by currency and as-of date for review and delivery.</description>
        <implements service="mantle.account.CollectionServices.define#StatementParameters"/>
        <out-parameters>
            <parameter name="snapshotId"/>
            <parameter name="inputFingerprint"/>
            <parameter name="statementRows" type="List"/>
            <parameter name="previewHtml"/>
            <parameter name="results" type="List"/>
        </out-parameters>
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/account/Statements.js').execute('preview', context))</script>
        </actions>
    </service>
    <service verb="get" noun="StatementPreview" allow-remote="false">
        <description>Read the exact authorized statement snapshot and its delivery results.</description>
        <implements service="mantle.account.CollectionServices.define#StatementParameters"/>
        <out-parameters>
            <parameter name="snapshotId"/>
            <parameter name="inputFingerprint"/>
            <parameter name="statementRows" type="List"/>
            <parameter name="previewHtml"/>
            <parameter name="results" type="List"/>
        </out-parameters>
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/account/Statements.js').execute('get', context))</script>
        </actions>
    </service>
    <service verb="prepare" noun="StatementSend" allow-remote="false">
        <description>Reserve statement request identity before any recipient delivery, or return its durable completed result.</description>
        <implements service="mantle.account.CollectionServices.define#StatementParameters"/>
        <out-parameters>
            <parameter name="complete" type="Boolean"/>
            <parameter name="result" type="Map"/>
            <parameter name="requestHash"/>
        </out-parameters>
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/account/Statements.js').execute('prepare', context))</script>
        </actions>
    </service>
    <service verb="send" noun="Statements" allow-remote="false" transaction="ignore">
        <description>Send only a current reviewed statement snapshot, retaining independent recipient results and same-key replay.</description>
        <implements service="mantle.account.CollectionServices.define#StatementParameters"/>
        <out-parameters>
            <parameter name="snapshotId"/>
            <parameter name="results" type="List"/>
            <parameter name="successCount" type="Integer"/>
            <parameter name="failureCount" type="Integer"/>
            <parameter name="alreadyApplied" type="Boolean"/>
        </out-parameters>
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/account/Statements.js').execute('send', context))</script>
        </actions>
    </service>
    <service verb="deliver" noun="StatementRecipient" allow-remote="false">
        <description>Deliver one frozen customer and currency statement through an authorized native mail draft.</description>
        <implements service="mantle.account.CollectionServices.define#StatementParameters"/>
        <out-parameters>
            <parameter name="customerPartyId"/>
            <parameter name="currencyUomId"/>
            <parameter name="recipient"/>
            <parameter name="status"/>
            <parameter name="reasonCode"/>
            <parameter name="emailMessageId"/>
            <parameter name="errorMessage"/>
            <parameter name="alreadyApplied" type="Boolean"/>
        </out-parameters>
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/account/Statements.js').execute('deliver', context))</script>
        </actions>
    </service>
    <service verb="record" noun="StatementResult" allow-remote="false">
        <description>Persist the authorized aggregate statement outcome on the common posting operation.</description>
        <implements service="mantle.account.CollectionServices.define#StatementParameters"/>
        <out-parameters>

        </out-parameters>
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/account/Statements.js').execute('recordResult', context))</script>
        </actions>
    </service>
</services>
