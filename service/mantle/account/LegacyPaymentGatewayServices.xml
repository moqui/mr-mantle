<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="prepare" noun="Fence" transaction="force-new" allow-remote="false">
        <description>Internal durable first-fence creation without locking any financial row, including an uncommitted caller Payment.</description>
        <in-parameters>
            <parameter name="paymentIdList" type="List" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="complete" type="Boolean"/>
        </out-parameters>
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/account/LegacyPaymentGatewayGuard.js').prepareFence(context))</script>
        </actions>
    </service>
    <service verb="record" noun="Use" transaction="force-new" allow-remote="false">
        <description>Internal permanent legacy admission before provider I/O; locks only existing fences and rechecks managed provenance after waiting.</description>
        <in-parameters>
            <parameter name="paymentIdList" type="List" required="true"/>
            <parameter name="serviceName" required="true"/>
            <parameter name="paymentGatewayConfigId"/>
        </in-parameters>
        <out-parameters>
            <parameter name="complete" type="Boolean"/>
        </out-parameters>
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/account/LegacyPaymentGatewayGuard.js').recordUse(context))</script>
        </actions>
    </service>
</services>
