    <service allow-remote="false" verb="get" noun="Readiness">
        <description>Check authorized accounting setup health without exposing administration settings; name independent failures.</description>
        <implements service="mantle.ledger.SetupServices.define#Parameters" />
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/ledger/AccountingSetup.js').execute('readiness',context))</script>
        </actions>
    </service>
</services>
