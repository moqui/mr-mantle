<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="define" noun="Parameters" type="interface">
        <in-parameters>
            <parameter name="kind" type="String" />
            <parameter name="organizationPartyId" type="String" />
            <parameter name="recordId" type="String" />
            <parameter name="text" type="String" />
            <parameter name="acctgTransId" type="String" />
            <parameter name="glAccountId" type="String" />
            <parameter name="parentGlAccountId" type="String" />
            <parameter name="glJournalId" type="String" />
            <parameter name="isPosted" type="String" />
            <parameter name="otherPartyId" type="String" />
            <parameter name="currencyUomId" type="String" />
            <parameter name="description" type="String" />
            <parameter name="pageIndex" type="Integer" />
            <parameter name="pageSize" type="Integer" />
            <parameter name="amount" type="BigDecimal" />
            <parameter name="invoiceDate" type="Timestamp" />
        </in-parameters>
        <out-parameters>
            <parameter name="capabilities" type="Map" />
            <parameter name="record" type="Map" />
            <parameter name="organizationPartyIds" type="List" />
            <parameter name="allowedOrganizationPartyIds" type="List" />
            <parameter name="activeOrganizationPartyId" type="String" />
            <parameter name="records" type="List" />
            <parameter name="recordCount" type="Long" />
            <parameter name="pageIndex" type="Integer" />
            <parameter name="pageSize" type="Integer" />
            <parameter name="lines" type="List" />
            <parameter name="recordId" type="String" />
            <parameter name="debitTotal" type="BigDecimal" />
            <parameter name="creditTotal" type="BigDecimal" />
            <parameter name="debitCreditDifference" type="BigDecimal" />
            <parameter name="recordsCount" type="Integer" />
            <parameter name="recordsPageSize" type="Integer" />
            <parameter name="recordsPageIndex" type="Integer" />
            <parameter name="recordsPageMaxIndex" type="Integer" />
            <parameter name="recordsPageRangeLow" type="Integer" />
            <parameter name="recordsPageRangeHigh" type="Integer" />
        </out-parameters>
    </service>
    <service verb="get" noun="Access" allow-remote="false">
        <description>Resolve native finance permissions and authenticated organization scope.</description>
        <implements service="mantle.ledger.AccountingServices.define#Parameters" />
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/ledger/AccountingRecords.js').execute('access', context))</script>
        </actions>
    </service>
    <service verb="find" noun="Records" allow-remote="false">
        <description>Find only authorized finance records, with database pagination.</description>
        <implements service="mantle.ledger.AccountingServices.define#Parameters" />
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/ledger/AccountingRecords.js').execute('list', context))</script>
        </actions>
    </service>
    <service verb="get" noun="Record" allow-remote="false">
        <description>Read an authorized finance record and its permitted child lines.</description>
        <implements service="mantle.ledger.AccountingServices.define#Parameters" />
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/ledger/AccountingRecords.js').execute('read', context))</script>
        </actions>
    </service>
    <service verb="create" noun="DraftDocument" allow-remote="false">
        <description>Create an authorized draft invoice, bill or proposed payment; never finalizes or settles.</description>
        <implements service="mantle.ledger.AccountingServices.define#Parameters" />
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/ledger/AccountingRecords.js').execute('draft', context))</script>
        </actions>
    </service>
</services>
