            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/ledger/Journals.js').execute('template', context))</script>
        </actions>
    </service>
    <service verb="store" noun="TemplateLines" allow-remote="false">
        <description>Validate balanced fixed and parameterized lines and publish the template.</description>
        <implements service="mantle.ledger.JournalServices.define#Parameters" />
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/ledger/Journals.js').execute('templateLines', context))</script>
        </actions>
    </service>
    <service verb="create" noun="FromTemplate" allow-remote="false">
        <description>Create an independent unposted draft from an effective published template.</description>
        <implements service="mantle.ledger.JournalServices.define#Parameters" />
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/ledger/Journals.js').execute('instantiate', context))</script>
        </actions>
    </service>
    <service verb="get" noun="Preview" allow-remote="false">
        <description>Read the current actor's reviewed journal preview and recheck its validity.</description>
        <implements service="mantle.ledger.JournalServices.define#Parameters" />
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/ledger/Journals.js').execute('getPreview',context))</script>
        </actions>
    </service>
    <service verb="get" noun="BatchPreview" allow-remote="false">
        <description>Read the actor's batch preview and per-transaction posting outcomes.</description>
        <implements service="mantle.ledger.JournalServices.define#Parameters" />
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/ledger/Journals.js').execute('getBatchPreview',context))</script>
        </actions>
    </service>
    <service verb="store" noun="TemplateLine" allow-remote="false">
        <description>Save one draft template line and require revalidation before instantiation.</description>
        <implements service="mantle.ledger.JournalServices.define#Parameters" />
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/ledger/Journals.js').execute('templateLine',context))</script>
        </actions>
