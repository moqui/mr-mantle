        <description>Delete only a current unpublished template line.</description>
        <implements service="mantle.ledger.JournalServices.define#Parameters" />
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/ledger/Journals.js').execute('removeTemplateLine',context))</script>
        </actions>
