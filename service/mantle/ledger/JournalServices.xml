<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="define" noun="Parameters" type="interface">
        <in-parameters>
            <parameter name="organizationPartyId" type="String" />
            <parameter name="acctgTransId" type="String" />
            <parameter name="acctgTransEntrySeqId" type="String" />
            <parameter name="destinationAcctgTransId" type="String" />
            <parameter name="glAccountId" type="String" />
            <parameter name="debitCreditFlag" type="String" />
            <parameter name="description" type="String" />
            <parameter name="acctgTransTypeEnumId" type="String" />
            <parameter name="amountUomId" type="String" />
            <parameter name="glJournalId" type="String" />
            <parameter name="glJournalName" type="String" />
            <parameter name="otherPartyId" type="String" />
            <parameter name="workEffortId" type="String" />
            <parameter name="productId" type="String" />
            <parameter name="assetId" type="String" />
            <parameter name="facilityId" type="String" />
            <parameter name="costCenterId" type="String" />
            <parameter name="previewId" type="String" />
            <parameter name="inputFingerprint" type="String" />
            <parameter name="operationKey" type="String" />
            <parameter name="changeReason" type="String" />
            <parameter name="acctgTransTemplateId" type="String" />
            <parameter name="templateName" type="String" />
            <parameter name="entrySeqId" type="String" />
            <parameter name="amountParameter" type="String" />
            <parameter name="transactionDate" type="Timestamp" />
            <parameter name="reversalDate" type="Timestamp" />
            <parameter name="lastUpdatedStamp" type="Timestamp" />
            <parameter name="fromDate" type="Timestamp" />
            <parameter name="thruDate" type="Timestamp" />
            <parameter name="amount" type="BigDecimal" />
            <parameter name="lines" type="List" />
            <parameter name="acctgTransIds" type="List" />
            <parameter name="amounts" type="Map" />
        </in-parameters>
        <out-parameters>
            <parameter name="acctgTransId" type="String" />
            <parameter name="acctgTransEntrySeqId" type="String" />
            <parameter name="glJournalId" type="String" />
            <parameter name="acctgTransTemplateId" type="String" />
            <parameter name="previewId" type="String" />
            <parameter name="inputFingerprint" type="String" />
            <parameter name="valid" type="Boolean" />
            <parameter name="alreadyPosted" type="Boolean" />
            <parameter name="findings" type="List" />
            <parameter name="results" type="List" />
            <parameter name="complete" type="Boolean" />
            <parameter name="debitTotal" type="BigDecimal" />
            <parameter name="creditTotal" type="BigDecimal" />
        </out-parameters>
    </service>
    <service verb="store" noun="DraftEntry" allow-remote="false">
        <description>Create or update an authorized draft header with optimistic concurrency.</description>
        <implements service="mantle.ledger.JournalServices.define#Parameters" />
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/ledger/Journals.js').execute('draft', context))</script>
        </actions>
    </service>
    <service verb="store" noun="DraftLine" allow-remote="false">
        <description>Save a draft debit or credit line; posted lines are immutable.</description>
        <implements service="mantle.ledger.JournalServices.define#Parameters" />
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/ledger/Journals.js').execute('line', context))</script>
        </actions>
    </service>
    <service verb="delete" noun="DraftLine" allow-remote="false">
        <description>Delete a current draft line.</description>
        <implements service="mantle.ledger.JournalServices.define#Parameters" />
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/ledger/Journals.js').execute('removeLine', context))</script>
        </actions>
    </service>
    <service verb="delete" noun="DraftEntry" allow-remote="false">
        <description>Delete only an authorized current draft.</description>
        <implements service="mantle.ledger.JournalServices.define#Parameters" />
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/ledger/Journals.js').execute('remove', context))</script>
        </actions>
    </service>
    <service verb="move" noun="DraftLine" allow-remote="false">
        <description>Atomically move a line between two drafts in the same organization and currency.</description>
        <implements service="mantle.ledger.JournalServices.define#Parameters" />
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/ledger/Journals.js').execute('move', context))</script>
        </actions>
    </service>
    <service verb="preview" noun="Entry" allow-remote="false">
        <description>Read authoritative posting checks and persist the reviewed fingerprint.</description>
        <implements service="mantle.ledger.JournalServices.define#Parameters" />
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/ledger/Journals.js').execute('preview', context))</script>
        </actions>
    </service>
    <service verb="post" noun="Entry" allow-remote="false">
        <description>Revalidate a reviewed entry under lock and post once per operation key.</description>
        <implements service="mantle.ledger.JournalServices.define#Parameters" />
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/ledger/Journals.js').execute('post', context))</script>
        </actions>
    </service>
    <service verb="reverse" noun="Entry" allow-remote="false">
        <description>Post a linked dated reversal once; preserve the original.</description>
        <implements service="mantle.ledger.JournalServices.define#Parameters" />
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/ledger/Journals.js').execute('reverse', context))</script>
        </actions>
    </service>
    <service verb="update" noun="PostedMetadata" allow-remote="false">
        <description>Audited description-only correction with a mandatory reason; no financial fields accepted.</description>
        <implements service="mantle.ledger.JournalServices.define#Parameters" />
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/ledger/Journals.js').execute('metadata', context))</script>
        </actions>
    </service>
    <service verb="store" noun="Batch" allow-remote="false">
        <description>Create or amend an unposted organization journal batch.</description>
        <implements service="mantle.ledger.JournalServices.define#Parameters" />
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/ledger/Journals.js').execute('batch', context))</script>
        </actions>
    </service>
    <service verb="validate" noun="Batch" allow-remote="false">
        <description>Preview each unposted constituent of an authorized batch.</description>
        <implements service="mantle.ledger.JournalServices.define#Parameters" />
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/ledger/Journals.js').execute('validateBatch', context))</script>
        </actions>
    </service>
    <service verb="post" noun="Batch" allow-remote="false">
        <description>Post independent batch transactions atomically, report each failure and continue.</description>
        <implements service="mantle.ledger.JournalServices.define#Parameters" />
        <actions>
            <script>ec.context.putAll(ec.resource.script('component://mr-mantle/service/mantle/ledger/Journals.js').execute('postBatch', context))</script>
        </actions>
    </service>
    <service verb="store" noun="Template" allow-remote="false">
