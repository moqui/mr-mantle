<emecas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/email-eca-3.xsd">
    <!-- PASS forum mail: a stored message to a registered forum route address (or its plus-tagged reply address) is
        handled by mantle.forum.DeliveryServices.process#Inbound; it leaves any other message alone. -->
    <emeca rule-name="ForumInbound">
        <condition><expression>!!(fields &amp;&amp; fields.from)</expression></condition>
        <actions>
            <service-call name="mantle.forum.DeliveryServices.process#Inbound" in-map="context"/>
        </actions>
    </emeca>
</emecas>
