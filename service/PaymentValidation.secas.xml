<secas xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-eca-3.xsd">
    <!-- A proposed payment, new or edited, is sent for validation once its draft commits. -->
    <seca id="PaymentDraftValidationNotice" service="mantle.account.PaymentServices.create#PaymentDraft" when="tx-commit"
            run-on-error="false">
        <condition>
            <expression>validationRequired &amp;&amp; !alreadyApplied &amp;&amp; !!validationEventId</expression>
        </condition>
        <actions>
            <service-call name="mantle.account.PaymentNotificationServices.send#PaymentValidationNotice"
                    in-map="{paymentId:paymentId, validationEventId:validationEventId, sourceVersion:validationSourceVersion}"/>
        </actions>
    </seca>
    <seca id="PaymentEditValidationNotice" service="mantle.account.PaymentServices.store#PaymentDraft" when="tx-commit"
            run-on-error="false">
        <condition>
            <expression>validationRequired &amp;&amp; !alreadyApplied &amp;&amp; !!validationEventId</expression>
        </condition>
        <actions>
            <service-call name="mantle.account.PaymentNotificationServices.send#PaymentValidationNotice"
                    in-map="{paymentId:paymentId, validationEventId:validationEventId, sourceVersion:validationSourceVersion}"/>
        </actions>
    </seca>
</secas>
